#!/usr/bin/env bash
# flightbox-p4 — lay out flightbox's raw ring partition (p4) at the TAIL of a
# freshly burned card (pi-tools#t-058 ⑥; design: flightbox/README.md).
#
#   sudo image/flightbox-p4 /dev/sdX            # a burned card, unmounted
#   image/flightbox-p4 card.img                 # a plain file works too (desk)
#   image/flightbox-p4 --check IMAGE            # read-only: would a card burned from it take p4?
#   bench/burn-batch --flightbox IMAGE ...      # runs this on every card that verified
#
# Why at burn and why at the tail: the golden image keeps three partitions
# (boot, root, /data) so it stays one size for every card, and only the burn
# knows the card's size. p4 goes to the LAST 512 MB of the card; the gap
# between /data's end and p4 is what extendfs grows /data into at first boot
# (it grows /data's own partition, up to the next one — never the disk's last
# partition, which is now p4 and has no filesystem). Cards in service are never
# repartitioned: they use flightbox's file mode.
#
# What it writes, in this order:
#   1. zeros over the region p4 will cover, in one sequential pass — a reused
#      card's tail can hold an earlier card's flightbox records with valid CRCs,
#      which the boot scan would take for this card's trail;
#   2. one MBR entry, type 0xda (non-FS data), aligned to 4 MiB.
# A cut during 1 leaves no p4 (re-run redoes it); 2 is one sector.
#
# Idempotent: a p4 already laid out by this tool is reported, never rewritten.
# Refuses (exit 1, nothing written): not an MBR disk, not exactly three
# partitions, a fourth partition that is not ours, an extendfs on p2 that does
# not grow /data's own partition (below), no 512 MB free at the tail.
#
# The extendfs refusal (pi-tools#t-060): every image burned before Pi-tools
# d17d886 (RastaOS 7.3, 7.4) carries an extendfs that grows the disk's LAST
# partition. With p4 there, that is p4: growpart and resize2fs fail on a raw
# partition, /data stays at the image size, and extendfs stops before the
# identity reset — the clone keeps the donor's machine-id and SSH host keys
# (pi-tools#t-006). Such a card is refused and stays a good file-mode card.
#
# --check runs the same refusals, room excepted (an image has no tail), and
# writes nothing: burn-batch asks it about the IMAGE before the burn.
#   FLIGHTBOX_P4_MB   size (default 512)
#   FLIGHTBOX_P4_NOZERO=1   skip step 1 (desk tests only)
set -euo pipefail

say() { echo "flightbox-p4: $*"; }
die() { echo "flightbox-p4: $1" >&2; exit "${2:-1}"; }

CHECK=0
[ "${1:-}" = --check ] && { CHECK=1; shift; }
DEV="${1:-}"
[ -n "$DEV" ] && [ $# -eq 1 ] || die "usage: flightbox-p4 [--check] <card device | image file>" 2
[ -e "$DEV" ] || die "$DEV: no such device or file" 2

MB="${FLIGHTBOX_P4_MB:-512}"
case "$MB" in ''|*[!0-9]*|0) die "FLIGHTBOX_P4_MB wants a whole number of MB, got '$MB'" 2 ;; esac
[ $(( MB % 4 )) -eq 0 ] || die "FLIGHTBOX_P4_MB must be a multiple of 4 (the zeroing pass writes 4 MB blocks), got $MB" 2
SIZE=$(( MB * 2048 ))          # 512-B sectors
ALIGN=8192                     # 4 MiB, the grid the RastaOS partitions sit on

if [ -b "$DEV" ]; then
    SECTORS=$(blockdev --getsz "$DEV")
    findmnt -nro SOURCE | grep -q "^$(readlink -f "$DEV")" \
        && die "$DEV has a mounted partition — unmount the card first (burn-batch does)"
else
    SECTORS=$(( $(stat -c %s "$DEV") / 512 ))
fi

DUMP=$(sfdisk -d "$DEV" 2>/dev/null) || die "$DEV: no partition table sfdisk can read"
grep -q '^label: dos' <<<"$DUMP" || die "$DEV: not an MBR (dos) disk — the RastaOS layout is MBR; nothing written"
mapfile -t PARTS < <(grep -E '^[^ ]+ *: *start=' <<<"$DUMP")
field() { sed -n "s/.*$2= *\([0-9a-fx]*\).*/\1/p" <<<"$1"; }

# Does p2's extendfs grow /data's own partition? Read off the root filesystem
# with debugfs — no mount, and no root on an image file. The file is the one
# extendfs.service runs, /usr/local/bin/extendfs, followed through its symlinks
# (the installer links it to /opt/Pi-tools/extendfs/extendfs). GROWS_DATA is
# d17d886's own assignment: bench/flightbox-p4-desk.sh runs this tree's extendfs
# through this probe, so a change to that line goes red there first.
# shellcheck disable=SC2016  # the literal text of extendfs's line, never expanded
GROWS_DATA='LAST_PART="$DATA_PART"'
extendfs_grows_data() {   # <p2 start sector> -> 0 yes; else 1 and the reason on stdout
    local fs="$DEV?offset=$(( $1 * 512 ))" f=/usr/local/bin/extendfs st dest body
    command -v debugfs >/dev/null || { echo "no debugfs (e2fsprogs) to read the extendfs on p2"; return 1; }
    for _ in 1 2 3 4 5 6 7 8; do
        st=$(DEBUGFS_PAGER=__none__ debugfs -R "stat $f" "$fs" 2>/dev/null || true)
        case "$st" in
            *"Type: regular"*)
                # into a variable first: grep -q quits at its match, and under
                # pipefail the reader's SIGPIPE would turn that match into a miss
                body=$(DEBUGFS_PAGER=__none__ debugfs -R "cat $f" "$fs" 2>/dev/null || true)
                grep -qF "$GROWS_DATA" <<<"$body" && return 0
                echo "its extendfs grows the disk's LAST partition (an image from before Pi-tools d17d886: RastaOS 7.3/7.4) — with p4 there it would grow p4, not /data, and stop before the identity reset"
                return 1 ;;
            *"Type: symlink"*)
                dest=$(sed -n 's/^Fast link dest: "\(.*\)"$/\1/p' <<<"$st")
                [ -n "$dest" ] || dest=$(DEBUGFS_PAGER=__none__ debugfs -R "cat $f" "$fs" 2>/dev/null || true)
                case "$dest" in /*) f=$dest ;; *) f=${f%/*}/$dest ;; esac ;;
            *)
                echo "no extendfs at $f on p2 — nothing shows /data grows at first boot"
                return 1 ;;
        esac
    done
    echo "$f: too many symlinks to reach extendfs"; return 1
}

START=$(( (SECTORS - SIZE) / ALIGN * ALIGN ))

OURS=0
if [ "${#PARTS[@]}" -eq 4 ]; then
    p4="${PARTS[3]}"
    if [ "$(field "$p4" type)" = "da" ] && [ "$(field "$p4" size)" = "$SIZE" ] \
       && [ "$(field "$p4" start)" = "$START" ]; then
        OURS=1
    else
        die "$DEV already has a fourth partition that is not flightbox's tail p4 — nothing written"
    fi
fi
[ "$OURS" = 1 ] || [ "${#PARTS[@]}" -eq 3 ] || die "$DEV has ${#PARTS[@]} partitions, the RastaOS image has 3 (boot, root, /data) — nothing written"

if ! why=$(extendfs_grows_data "$(field "${PARTS[1]}" start)"); then
    [ "$OURS" = 1 ] && die "$DEV: $why. This card already has p4: \`sfdisk --delete $DEV 4\` puts it back in file mode. Nothing written"
    die "$DEV: $why. flightbox's p4 wants a RastaOS 7.5 image. Nothing written: the card runs file mode"
fi

if [ "$OURS" = 1 ]; then
    say "p4 already laid out at sector $START ($MB MB) — nothing to do"
    exit 0
fi
if [ "$CHECK" = 1 ]; then
    say "$DEV: MBR, three partitions, an extendfs that grows /data — a card burned from it takes p4. Nothing written"
    exit 0
fi

p3="${PARTS[2]}"
P3_END=$(( $(field "$p3" start) + $(field "$p3" size) - 1 ))
[ "$START" -gt "$P3_END" ] || die "no $MB MB free after /data (ends at sector $P3_END of $SECTORS) — this card is too small for p4; flightbox will use file mode. Nothing written"

if [ "${FLIGHTBOX_P4_NOZERO:-0}" != 1 ]; then
    say "zeroing the $MB MB p4 will cover (one pass)"
    if [ -b "$DEV" ]; then
        dd if=/dev/zero of="$DEV" bs=4M count=$(( MB / 4 )) seek=$(( START * 512 )) \
           oflag=seek_bytes,direct conv=fsync status=none
    else
        dd if=/dev/zero of="$DEV" bs=4M count=$(( MB / 4 )) seek=$(( START * 512 )) \
           oflag=seek_bytes conv=notrunc,fsync status=none
    fi
fi

echo "start=$START, size=$SIZE, type=da" | sfdisk --append -q "$DEV" >/dev/null
say "p4 laid out: sectors $START–$(( START + SIZE - 1 )) ($MB MB, type da); /data grows into the $(( (START - P3_END - 1) / 2048 )) MB before it at first boot"
