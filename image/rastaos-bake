#!/usr/bin/env bash
# rastaos-bake — the RastaOS-7.5 recipe: converge a booted 7.4 card into the 7.5 golden, the card
# that is then captured (dd) and burned fresh. Every change made to the bench card lives here, so the
# image can be rebuilt instead of only copied (rastaos 13/11: "a recipe can be re-run, a capture cannot").
#
#   sudo image/rastaos-bake --tag rastaos-7.5     # on the card itself (root = /), as root
#   sudo image/rastaos-bake --tag T --root /mnt/p2 --boot /mnt/p1   # offline, a mounted card or .img
#   image/rastaos-bake --list                     # the steps, in order
#   sudo image/rastaos-bake --only dns,wifi       # a subset (comma-separated; no --tag without converge)
#   --bundle FILE  the tag from a git bundle (no network)   --nowde VER  the one Nowde firmware kept
#   --data DIR     the card's data partition (default /data; offline <root>/data)   --mire FILE  0_mire.mp4
#   sudo image/rastaos-bake --only seal --root /mnt/p2 --boot /mnt/p1 --data /mnt/p3   # the CAPTURED image
#
# Idempotent: a second run changes nothing and says so. Each step names the defect it removes.
# Run it from a Pi-tools tree at the release (a /tmp clone or bundle on the card), not from the
# card's own /opt/Pi-tools: 7.4's checkout has no image/ and no setup/rastaos-update.
# Steps so far (pi-tools#t-058; a later slice adds the p4 layout):
#   converge /opt/Pi-tools → the release tag, via THIS tree's setup/rastaos-update (receipt
#            /etc/rastaos-release + rollback point; live: the box's modules re-applied). 7.4's checkout
#            carried six commits no origin holds. Offline it moves the checkout and writes the receipt
#            only (MODULES=none): `rastaos-update --force <tag>` on the booted card re-applies them.
#            A failed converge stops the bake: nothing else is baked onto a card off the tag.
#   hplayer2 /opt/HPlayer2 → the same tag (from its origin, or --hp-bundle FILE), detached; the commit it
#            left is kept as refs/rastaos/rollback. 7.4 runs anna@c3e84d6, which has no `auto` profile.
#            Refuses local edits, and a tag whose uv.lock/pyproject.toml differ from the checkout's:
#            the shipped .venv would then be stale (anna74.sh's rule). Live, hplayer2@* is stopped first.
#   stamps   /etc/rastaos-patches.txt: the 7.4 bake stacked one anna74 line per run (5 on bench-01);
#            keep its LAST one and every older line, then ONE rastaos75 line (replaced, never stacked).
#   version  /boot/VERSION = 7.5. On 7.4 it still read "7.0 -- bootstraped from …", so nothing on a
#            card said 7.3 or 7.4 — and the burn rules read that file.
#   units    mask fake-hwclock (rorw's fake-clock keeps the clock; both ran on 7.4), rpi-eeprom-update
#            (a Pi 3 has no EEPROM; no firmware writes at a show), nfs-client.target, rsync.service.
#   rtc      the DS3231 overlay goes off by default: a board without the RTC logged "rtc-ds1307 probe
#            failed -5" at every boot. Per card: uncomment the line in config.txt.
#   dns      static /etc/resolv.conf on public resolvers + NM dns=none (knowledge: openresolv pointed
#            it at 127.0.0.1 → no DNS → no datesync/apt/git). Live root also purges openresolv/resolvconf.
#   wifi     /boot/wifi and the NM store lose wint-hotspot.nmconnection (it carries the fleet hotspot
#            PSK: hotspot off is only an installer default, a converged 7.4 card still held it) and the
#            store loses the _anna74-removed dir (NM "keyfile: error loading connection" every boot).
#   nowde    /opt/nowde-tools keeps ONE firmware: 7.4 held 2.0.3 (patch-golden 15/09) and 2.0.5
#            (patch-golden-29). Default 2.0.5 = Nowde main's NOWDE_VERSION + bin/ and the garden nodes.
#   media    /data/media back to the generic set: ONLY 0_mire.mp4. 7.4's bake put the Anna show set there
#            (+0.6 GB) and deleted the mire, which lives in no repo: --mire FILE puts it back (a 7.3 card's
#            /data/media/0_mire.mp4). The saved player settings /data/hplayer2*.cfg go too: a saved cfg
#            wins over the /boot/hplayer2.conf seeds. Empties the BENCH card's media — never a show player's.
#            No mire on the card and no --mire: the step fails before removing anything.
#   starter  /boot/starter.txt generic: hostrename@player-000 (the burn scripts' sed rewrites that line per
#            card) and hplayer2@auto (no /boot/hplayer2.conf = HPlayer2's default profile on /data/media);
#            7.4 shipped hplayer2@26-anna. /boot/hplayer2.conf goes (a role file: the /boot role sets bring
#            it), /etc/hostname + /etc/hosts say player-000. Refuses when the card's /opt/HPlayer2 has no
#            `auto` (it predates hplayer2#t-101): a starter naming a profile the player lacks plays nothing.
#   seal     NOT in the default run: `--only seal`, offline, on the captured image (or the card in a reader)
#            between the dd and the burn — never on the running card, whose rig access it would strip.
#            Arms extendfs's first-boot reset: drops the drive-id markers, so every card burned from the
#            image takes the clone path (new machine-id + SSH host keys, Tailscale wiped) even when its
#            fingerprint falls back to a UUID a dd copy shares (pi-tools#t-006, AUDIT-2026), and wires
#            extendfs.service; refuses if extendfs, its unit or growpart is missing (it would stop before
#            the reset). Host keys stay: extendfs regenerates them, and a card without keys has no ssh.
#            root's authorized_keys keeps only the fingerprints in image/authorized-keys.keep (--keys FILE):
#            the bench card also holds the loop's passphrase-less rig key. Refuses if no kept key remains.
#            Empties /data/var/tailscale, /data/var/log (bench-01's journal-export, blackbox.log) and the
#            root's /var/log/journal, removes root's .bash_history.
#
# Exit 0 done (or nothing to do), 1 a step failed, 2 usage / not a RastaOS root.
set -uo pipefail

ROOT=/ BOOT="" DATA="" ONLY="" LIVE=0 TAG="" BUNDLE="" HPBUNDLE="" NOWDE=2.0.5 MIRE="" KEYS="" CHECKOUT=/opt/Pi-tools
STEPS="converge hplayer2 stamps version units rtc dns wifi nowde media starter"
EXPLICIT="seal"   # runs only when --only names it
HOST=player-000 PLAYER=hplayer2@auto HPLAYER=/opt/HPlayer2
HERE=${BAKE_HOME:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)}
ARGS=("$@")
STAMP=rastaos75
MASK_UNITS="fake-hwclock.service rpi-eeprom-update.service nfs-client.target rsync.service"

say()  { echo "[bake] $*"; }
die()  { echo "[bake] FATAL: $*" >&2; exit "${2:-1}"; }
CHANGED=0
did()  { CHANGED=$((CHANGED + 1)); say "  $*"; }

usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT=${2:?--root DIR}; shift 2 ;;
    --boot) BOOT=${2:?--boot DIR}; shift 2 ;;
    --only) ONLY=${2:?--only step,step}; shift 2 ;;
    --tag) TAG=${2:?--tag TAG}; shift 2 ;;
    --bundle) BUNDLE=$(readlink -f "${2:?--bundle FILE}"); shift 2 ;;
    --nowde) NOWDE=${2:?--nowde VERSION}; shift 2 ;;
    --hp-bundle) HPBUNDLE=$(readlink -f "${2:?--hp-bundle FILE}"); shift 2 ;;
    --data) DATA=${2:?--data DIR}; shift 2 ;;
    --mire) MIRE=$(readlink -f "${2:?--mire FILE}"); shift 2 ;;
    --keys) KEYS=$(readlink -f "${2:?--keys FILE}"); shift 2 ;;
    --list) for s in $STEPS $EXPLICIT; do echo "$s"; done; exit 0 ;;
    -h|--help) usage ;;
    *) echo "unknown argument: $1" >&2; usage ;;
  esac
done
ROOT=${ROOT%/}; [ -z "$ROOT" ] && ROOT=/
[ "$ROOT" = / ] && LIVE=1
[ -n "$BOOT" ] || { [ "$ROOT" = / ] && BOOT=/boot || BOOT=$ROOT/boot; }
[ -n "$DATA" ] || { [ "$ROOT" = / ] && DATA=/data || DATA=$ROOT/data; }
r() { [ "$ROOT" = / ] && echo "$1" || echo "$ROOT$1"; }    # path inside the target root
case ",$ONLY," in *,seal,*) [ "$LIVE" = 1 ] && die "seal runs on the captured image (--root/--boot/--data), never on the running card: it strips the rig's key and resets this card at its next boot" 2 ;; esac

[ -d "$(r /etc)" ] || die "$ROOT has no /etc: not a root filesystem" 2
[ -f "$BOOT/config.txt" ] || die "$BOOT/config.txt missing: pass --boot <the card's p1>" 2
[ "$LIVE" = 0 ] || [ "$(id -u)" = 0 ] || die "on a live card this runs as root" 2
if [ -n "$ONLY" ]; then
  for s in ${ONLY//,/ }; do case " $STEPS $EXPLICIT " in *" $s "*) ;; *) die "unknown step: $s (see --list)" 2 ;; esac; done
fi
runs() { if [ -z "$ONLY" ]; then case " $EXPLICIT " in *" $1 "*) return 1 ;; esac; return 0; fi
         case ",$ONLY," in *",$1,"*) ;; *) return 1 ;; esac; }
runs converge && [ -z "$TAG" ] && die "converge needs --tag <release> (or --only without converge)" 2
runs hplayer2 && [ -z "$TAG" ] && die "hplayer2 needs --tag <release> (or --only without it)" 2
UPDATER=$HERE/../setup/rastaos-update
runs converge && [ ! -f "$UPDATER" ] && die "$UPDATER absent: run the bake from a tree at the release" 2

# --- live: the converge moves a checkout that may hold this very script — run from a copy.
if [ "$LIVE" = 1 ] && [ -z "${BAKE_COPY:-}" ]; then
  d=${TMPDIR:-/run}; [ -d "$d" ] && [ -w "$d" ] || d=/tmp
  c=$(mktemp "$d/rastaos-bake.XXXXXX") && cat "$0" > "$c" || die "could not copy itself to $d" 2
  BAKE_COPY=$c BAKE_HOME=$HERE exec bash "$c" "${ARGS[@]}"
fi

REV=$(git -C "$HERE" rev-parse --short HEAD 2>/dev/null || echo unknown)

# --- live root on rorw is read-only: open it for the bake, close it after (rorw's own counter).
RW_OPENED=0
if [ "$LIVE" = 1 ] && findmnt -rno OPTIONS / | tr , '\n' | grep -qx ro; then
  command -v rw >/dev/null || die "root is read-only and rorw's rw is absent"
  rw >/dev/null || die "rw failed"; RW_OPENED=1
fi
cleanup() {
  [ -n "${BAKE_COPY:-}" ] && rm -f "$BAKE_COPY"
  [ "$RW_OPENED" = 1 ] && { sync; ro >/dev/null 2>&1 || say "WARN: ro failed — root left writable"; }
}
trap cleanup EXIT

# ---------------------------------------------------------------- steps
step_converge() {
  local co out rc; co=$(r "$CHECKOUT")
  git -C "$co" rev-parse --git-dir >/dev/null 2>&1 || { say "converge: no git checkout at $co"; return 1; }
  local env=(PITOOLS_DIR="$co") noproc=""
  if [ "$LIVE" = 0 ]; then   # a mounted root: move the checkout, write ITS receipt, touch no host process
    noproc=$(mktemp -d)
    env+=(RASTAOS_RELEASE="$(r /etc/rastaos-release)" RASTAOS_NO_RORW=1 RASTAOS_NO_CONVERGE=1 RASTAOS_PROC="$noproc")
  fi
  out=$(env "${env[@]}" bash "$UPDATER" ${BUNDLE:+--bundle "$BUNDLE"} "$TAG" 2>&1); rc=$?
  [ -n "$noproc" ] && rmdir "$noproc"
  printf '%s\n' "$out" | sed 's/^/    /'
  [ "$rc" = 0 ] || { say "converge: rastaos-update exit $rc"; return 1; }
  printf '%s' "$out" | grep -q 'nothing to do$' && return 0
  did "converge: $CHECKOUT at $TAG$([ "$LIVE" = 0 ] && echo " (offline: modules re-apply on the booted card, rastaos-update --force $TAG)")"
}

step_hplayer2() {
  local co head want; co=$(r "$HPLAYER")
  hg() { git -C "$co" "$@"; }
  hg rev-parse --git-dir >/dev/null 2>&1 || { say "hplayer2: no git checkout at $co"; return 1; }
  head=$(hg rev-parse HEAD) || return 1
  hg diff --quiet HEAD -- || { say "hplayer2: local edits in $co — commit or stash them; nothing moved"; return 1; }
  if ! hg rev-parse -q --verify "refs/tags/$TAG^{commit}" >/dev/null; then
    hg fetch -q "${HPBUNDLE:-origin}" "refs/tags/$TAG:refs/tags/$TAG" \
      || { say "hplayer2: could not fetch $TAG from ${HPBUNDLE:-origin}"; return 1; }
  fi
  want=$(hg rev-parse "refs/tags/$TAG^{commit}") || return 1
  [ "$head" = "$want" ] && return 0
  hg diff --quiet "$head" "$want" -- uv.lock pyproject.toml \
    || { say "hplayer2: $TAG changes uv.lock/pyproject.toml — the card's .venv would be stale; nothing moved"; return 1; }
  [ "$LIVE" = 1 ] && systemctl stop 'hplayer2@*' 2>/dev/null
  hg update-ref refs/rastaos/rollback "$head" || return 1
  hg -c advice.detachedHead=false checkout -q --detach "$want" || { say "hplayer2: checkout of $TAG failed — still on ${head:0:7}"; return 1; }
  did "hplayer2: $HPLAYER ${head:0:7} → $TAG (${want:0:7}); rollback point ${head:0:7}"
}

step_stamps() {
  local f; f=$(r /etc/rastaos-patches.txt)
  local tmp; tmp=$(mktemp)
  # keep every line except the anna74 ones before the last, and any previous rastaos75 line
  local last_anna; last_anna=$(grep -n '^anna74 ' "$f" 2>/dev/null | tail -1 | cut -d: -f1)
  if [ -f "$f" ]; then
    awk -v last="${last_anna:-0}" -v st="$STAMP" '
      $1 == "anna74" && NR != last { next }
      $1 == st { next }
      { print }' "$f" > "$tmp"
  fi
  echo "$STAMP $(date +%F): RastaOS-7.5 from 7.4 — Pi-tools image/rastaos-bake@$REV (steps: $STEPS)" >> "$tmp"
  # idempotent: compare without the date/rev of our own line
  if [ -f "$f" ] && diff -q <(grep -v "^$STAMP " "$f") <(grep -v "^$STAMP " "$tmp") >/dev/null \
     && [ "$(grep -c "^$STAMP " "$f")" = 1 ]; then
    rm -f "$tmp"; return 0
  fi
  local before; before=$(grep -c '^anna74 ' "$f" 2>/dev/null)
  install -m 644 "$tmp" "$f"; rm -f "$tmp"
  did "stamps: anna74 lines ${before:-0} → $(grep -c '^anna74 ' "$f"), one $STAMP line"
}

step_version() {
  local f=$BOOT/VERSION
  if [ -f "$f" ] && head -1 "$f" | grep -q '^7\.5 -- '; then return 0; fi
  local was; was=$(head -1 "$f" 2>/dev/null | cut -c1-60)
  printf '7.5 -- RastaOS-7.5, baked from a 7.4 card by Pi-tools image/rastaos-bake@%s\n' "$REV" > "$f"
  did "version: /boot/VERSION '${was:-absent}' → 7.5"
}

step_units() {
  local S u w; S=$(r /etc/systemd/system)
  mkdir -p "$S"
  for u in $MASK_UNITS; do
    for w in "$S"/*.wants/"$u" "$S"/*.requires/"$u"; do
      [ -e "$w" ] || [ -L "$w" ] || continue
      rm -f "$w"; did "units: $u unwired from $(basename "$(dirname "$w")")"
    done
    if [ "$(readlink "$S/$u" 2>/dev/null)" != /dev/null ]; then
      [ -e "$S/$u" ] && [ ! -L "$S/$u" ] && { say "WARN: $S/$u is a real file, not masking it"; continue; }
      ln -sfn /dev/null "$S/$u"; did "units: $u masked"
    fi
  done
  # fake-hwclock's hourly save writes /etc on a read-only root: it can only fail
  local c; c=$(r /etc/cron.hourly/fake-hwclock)
  [ -e "$c" ] && { rm -f "$c"; did "units: cron.hourly/fake-hwclock removed"; }
  [ "$LIVE" = 1 ] && [ "$CHANGED" -gt 0 ] && systemctl daemon-reload 2>/dev/null
  return 0
}

step_rtc() {
  local f=$BOOT/config.txt
  grep -qE '^[[:space:]]*dtoverlay=i2c-rtc' "$f" || return 0
  sed -i -E 's/^[[:space:]]*(dtoverlay=i2c-rtc.*)$/#\1    # per card: uncomment on a board WITH the DS3231 (rastaos 7.5)/' "$f"
  did "rtc: i2c-rtc overlay commented out in config.txt (per card)"
}

step_dns() {
  local f want=$'nameserver 1.1.1.1\nnameserver 1.0.0.1'; f=$(r /etc/resolv.conf)
  if [ "$LIVE" = 1 ]; then
    local p; for p in openresolv resolvconf; do
      dpkg -s "$p" >/dev/null 2>&1 && { DEBIAN_FRONTEND=noninteractive dpkg --purge "$p" >/dev/null && did "dns: $p purged"; }
    done
  fi
  if [ -L "$f" ] || [ "$(cat "$f" 2>/dev/null)" != "$want" ]; then
    rm -f "$f"; printf '%s\n' "$want" > "$f"; chmod 644 "$f"
    did "dns: static resolv.conf (1.1.1.1, 1.0.0.1)"
  fi
  local nm; nm=$(r /etc/NetworkManager)
  if ! grep -qsx 'dns=none' "$nm/NetworkManager.conf" "$nm"/conf.d/*.conf; then
    mkdir -p "$nm/conf.d"; printf '[main]\ndns=none\n' > "$nm/conf.d/90-rastaos-dns.conf"
    did "dns: NetworkManager dns=none (conf.d/90-rastaos-dns.conf)"
  fi
}

step_wifi() {
  local p; for p in "$BOOT/wifi/wint-hotspot.nmconnection" \
                    "$(r /etc/NetworkManager/system-connections/wint-hotspot.nmconnection)"; do
    [ -e "$p" ] && { rm -f "$p"; did "wifi: $p removed (fleet hotspot PSK; hotspot off by default)"; }
  done
  local d; d=$(r /etc/NetworkManager/system-connections/_anna74-removed)
  [ -d "$d" ] && { rm -rf "$d"; did "wifi: NM store _anna74-removed/ removed"; }
  return 0
}

step_nowde() {
  local d f; d=$(r /opt/nowde-tools)
  [ -d "$d" ] || return 0
  compgen -G "$d/nowde-$NOWDE-*.bin" >/dev/null || { say "nowde: no $NOWDE image in $d — nothing removed (--nowde <version>)"; return 1; }
  for f in "$d"/nowde-*.bin; do
    case "${f##*/}" in "nowde-$NOWDE-"*) continue ;; esac
    rm -f "$f"; did "nowde: ${f##*/} removed (one firmware: $NOWDE)"
  done
  return 0
}

step_media() {
  local m=$DATA/media mire=0_mire.mp4 x gone=() size
  [ -d "$m" ] || { say "media: no $m$([ "$LIVE" = 0 ] && echo " — pass --data <the card's p3, mounted>")"; return 1; }
  if [ -n "$MIRE" ]; then
    [ -f "$MIRE" ] && [ -s "$MIRE" ] || { say "media: --mire $MIRE is not a non-empty file — nothing removed"; return 1; }
  elif [ ! -s "$m/$mire" ]; then
    say "media: no $mire on the card and no --mire FILE (a 7.3 card's $mire) — nothing removed"; return 1
  fi
  while IFS= read -r -d '' x; do gone+=("${x##*/}"); done \
    < <(find "$m" -mindepth 1 -maxdepth 1 ! -name "$mire" -print0 | sort -z)
  if [ ${#gone[@]} -gt 0 ]; then
    size=$(cd "$m" && du -shc -- "${gone[@]}" 2>/dev/null | tail -1 | cut -f1)
    (cd "$m" && rm -rf -- "${gone[@]}") || { say "media: could not empty $m"; return 1; }
    did "media: ${#gone[@]} show file(s) removed from $m ($size): $(printf '%s ' "${gone[@]}" | cut -c1-160)"
  fi
  if [ -n "$MIRE" ] && ! cmp -s "$MIRE" "$m/$mire"; then
    install -m 644 "$MIRE" "$m/$mire" || { say "media: could not copy $MIRE"; return 1; }
    did "media: $mire from $MIRE"
  fi
  for x in "$DATA"/hplayer2*.cfg; do
    [ -f "$x" ] || continue
    rm -f "$x"; did "media: saved player settings ${x##*/} removed (/boot seeds apply only without one)"
  done
  return 0
}

step_starter() {
  local f=$BOOT/starter.txt hp tmp x was; hp=$(r "$HPLAYER")
  [ -f "$f" ] || { say "starter: no $f"; return 1; }
  if ! grep -qs 'def pick_profile' "$hp/core/engine/bootconf.py"; then
    say "starter: $HPLAYER ($(git -C "$hp" rev-parse --short HEAD 2>/dev/null || echo 'no checkout')) has no 'auto' profile (hplayer2#t-101) — move it to the release first; starter.txt left as is"
    return 1
  fi
  tmp=$(mktemp)
  # the FIRST active hostrename@ / hplayer2@ line becomes the generic one, later active ones go; comments stay
  awk -v host="hostrename@$HOST" -v player="$PLAYER" '
    /^[[:space:]]*hostrename@/ { if (!h++) print host; next }
    /^[[:space:]]*hplayer2@/   { if (!p++) print player; next }
    { print }
    END { if (!h) print host; if (!p) print player }' "$f" > "$tmp"
  if ! cmp -s "$f" "$tmp"; then
    was=$(grep -E '^[[:space:]]*(hostrename|hplayer2)@' "$f" | tr '\n' ' ')
    cat "$tmp" > "$f"; did "starter: '${was% }' → 'hostrename@$HOST $PLAYER'"
  fi
  rm -f "$tmp"
  [ -e "$BOOT/hplayer2.conf" ] && { rm -f "$BOOT/hplayer2.conf"; did "starter: /boot/hplayer2.conf removed (a role file; the base image has none)"; }
  x=$(r /etc/hostname)
  [ "$(cat "$x" 2>/dev/null)" = "$HOST" ] || { echo "$HOST" > "$x"; did "starter: /etc/hostname = $HOST"; }
  x=$(r /etc/hosts)
  if [ -f "$x" ] && grep -q '^127\.0\.1\.1' "$x" && ! grep -qxP "127\.0\.1\.1\t$HOST" "$x"; then
    sed -i -E "s/^127\.0\.1\.1.*/127.0.1.1\t$HOST/" "$x"; did "starter: /etc/hosts 127.0.1.1 = $HOST"
  fi
  return 0
}

step_seal() {
  local S unit w keep f line fp out tmp files=() n_root=0 drops=() d m
  S=$(r /etc/systemd/system); keep=${KEYS:-$HERE/authorized-keys.keep}
  lnk() { [ -e "$1" ] || [ -L "$1" ]; }    # an absolute link dangles outside the target root
  # --- every refusal before any write
  [ -d "$DATA/var" ] || { say "seal: no $DATA/var — pass --data <the image's p3, mounted>; nothing changed"; return 1; }
  lnk "$(r /usr/local/bin/extendfs)" || { say "seal: extendfs is not installed (./setup.sh extendfs) — nothing changed"; return 1; }
  unit=/etc/systemd/system/extendfs.service; lnk "$(r $unit)" || unit=/lib/systemd/system/extendfs.service
  lnk "$(r $unit)" || { say "seal: no extendfs.service unit — nothing changed"; return 1; }
  [ -x "$(r /usr/bin/growpart)" ] || { say "seal: no growpart (cloud-guest-utils): extendfs would stop before the identity reset — nothing changed"; return 1; }
  [ -s "$keep" ] || { say "seal: no keep-list $keep (--keys FILE) — nothing changed"; return 1; }
  for f in "$(r /root/.ssh/authorized_keys)" "$(r /root/.ssh/authorized_keys2)" "$(r /home)"/*/.ssh/authorized_keys "$(r /home)"/*/.ssh/authorized_keys2; do
    [ -f "$f" ] && files+=("$f")
  done
  local K; K=$(mktemp -d)
  for f in "${files[@]}"; do
    : > "$K/$(echo "$f" | md5sum | cut -c1-8)"
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in ''|'#'*) printf '%s\n' "$line" >> "$K/$(echo "$f" | md5sum | cut -c1-8)"; continue ;; esac
      printf '%s\n' "$line" > "$K/one"
      out=$(ssh-keygen -lf "$K/one" 2>/dev/null | head -1); fp=$(echo "$out" | awk '{print $2}')
      if [ -n "$fp" ] && awk -v fp="$fp" '$1 == fp { f = 1 } END { exit !f }' "$keep"; then
        printf '%s\n' "$line" >> "$K/$(echo "$f" | md5sum | cut -c1-8)"
        case "$f" in "$(r /root/.ssh)"/*) n_root=$((n_root + 1)) ;; esac
      else
        drops+=("${f#"${ROOT%/}"}: ${out:-unparsable line}")
      fi
    done < "$f"
  done
  if [ "$n_root" = 0 ]; then
    rm -rf "$K"; say "seal: no key of $keep in root's authorized_keys — the image would lock root out; nothing changed"; return 1
  fi
  # --- writes
  for f in "${files[@]}"; do
    tmp=$K/$(echo "$f" | md5sum | cut -c1-8)
    cmp -s "$f" "$tmp" || cat "$tmp" > "$f"
  done
  rm -rf "$K"
  for d in "${drops[@]}"; do did "seal: key dropped — $d"; done
  for m in "$DATA/var/drive-id" "$DATA/var/drive-id-stage1"; do
    [ -e "$m" ] && { rm -f "$m"; did "seal: extendfs marker ${m##*/} removed (first boot of every burned card = clone path)"; }
  done
  if [ -z "$(find "$S" -path "$S/*.wants/extendfs.service" 2>/dev/null | head -1)" ]; then
    mkdir -p "$S/multi-user.target.wants"; ln -sfn "$unit" "$S/multi-user.target.wants/extendfs.service"
    did "seal: extendfs.service wired to multi-user.target"
  fi
  for d in "$DATA/var/tailscale" "$(r /var/lib/tailscale)" "$DATA/var/log" "$(r /var/log/journal)"; do
    [ -d "$d" ] && [ -n "$(ls -A "$d" 2>/dev/null)" ] || continue
    find "$d" -mindepth 1 -delete && did "seal: ${d#"${ROOT%/}"} emptied"
  done
  f=$(r /root/.bash_history); [ -e "$f" ] && { rm -f "$f"; did "seal: root's .bash_history removed"; }
  return 0
}

# ---------------------------------------------------------------- run
say "RastaOS-7.5 bake @ $REV — root $ROOT, boot $BOOT$([ "$LIVE" = 1 ] && echo ' (live)')"
rc=0
for s in $STEPS $EXPLICIT; do
  runs "$s" || continue
  before=$CHANGED
  if ! "step_$s"; then
    say "step $s FAILED"; rc=1
    [ "$s" = converge ] && { say "converge failed — nothing else baked: fix it, then re-run"; break; }
    continue
  fi
  [ "$CHANGED" = "$before" ] && say "$s: already done"
done
[ "$rc" = 0 ] && say "done — $CHANGED change(s)" || say "finished with a failed step"
exit "$rc"
