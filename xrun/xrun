#!/bin/bash

# interactive only (prevent start over ssh)
# [[ $- != *i* ]] && return

#
# DEFAULT CONFIG
#
ROTATE="0"      # 0, 90, 180, 270
REFLECT="n"     # n, x, y, xy
NOCURSOR=""     # "", -nocursor

#
# CMD LINE OVERWRITE
#
while [[ $# -gt 0 ]]; do
  case $1 in
    -r|--rotate)
      ROTATE="$2"
      shift # past argument
      shift # past value
      ;;
    -m|--reflect)
      REFLECT="$2"
      shift # past argument
      shift # past value
      ;;
    -c|--nocursor)
      NOCURSOR="-nocursor"
      shift # past argument
      ;;
    -h|--help)
      echo "Usage: xrun [options]"
      echo " "
      echo "Options:"
      echo "  -r, --rotate <deg>     Rotate screen (0, 90, 180, 270)"
      echo "  -m, --reflect <mode>   Reflect screen (n, x, y, xy)"
      echo "  -c, --nocursor         Hide cursor"
      echo "  -h, --help             Show this help"
      echo " "
      exit 0
      ;;
    *)
      echo "Unknown argument $1"
      echo "See xrun --help for more info."
      exit 1
      ;;
  esac
done

# Validate ROTATE
case "$ROTATE" in
  0|90|180|270) ;;
  *)
    echo "ERROR: invalid rotation '$ROTATE' (must be 0, 90, 180, or 270)"
    exit 1
    ;;
esac

# Validate REFLECT
case "$REFLECT" in
  n|x|y|xy) ;;
  *)
    echo "ERROR: invalid reflect mode '$REFLECT' (must be n, x, y, or xy)"
    exit 1
    ;;
esac


#INFO
echo " "
echo ".:: XRUN ::."
echo " "
chmod 1777 /tmp   # ensure /tmp perms without stripping the sticky bit
XAUTHORITY=/tmp/.Xauthority XROTATE=$ROTATE XREFLECT=$REFLECT startx -- vt7 $NOCURSOR



