#!/bin/bash
# hdmi-rehandshake — re-negotiate the HDMI link with the EXPLICIT mode from config.txt.
#
#   hdmi-rehandshake [delay-seconds] [--wait N]     boot pass (the unit runs it before starter)
#   hdmi-rehandshake --late                          late pass (timer): only if the boot pass saw no display
#   hdmi-rehandshake --watch                         daytime pass (timer): poll for a display that
#                                                     RETURNS after boot, any time of day
#
# Why: with hdmi_force_hotplug=1 the firmware drives the link the instant it boots. A TV
# powered at the same moment (the venue's morning switch-on) can fail its first evaluation
# and latch "Mode non pris en charge" — Samsung SyncMasters did, on a mode they accept, and
# the only thing that cleared them was `tvservice -e` with explicit settings, which powers
# the output off and on with the mode spelled out (KARIKIS + LEA, 2026-09-10). Doing that
# once at boot, before the player starts, cures the boot path the same way.
#
# v2 (KOUAGOU, 2026-09-14): the boot pass first WAITS for the display to answer on the hotplug
# line (up to --wait s, default 20): a TV that powers up after the Pi got the re-handshake
# while it was still absent, and latched anyway. If no display showed up in time the pass
# asserts the mode regardless and leaves a marker; the late pass (timer, +75 s / +150 s) then
# re-asserts once a display has appeared and restarts the player, so a slow TV still gets a
# freshly negotiated link. A display that was present at boot is never touched again.
#
# v3 (2026-09-24): the boot pass and the late timer are both boot-gated — a TV cycled hours
# into the day (venue power-down, a set woken from standby) is still unreached. The watch pass
# polls the same `present()` check v2 uses (not a `tvservice -M` hotplug listener: v2's field
# walk proved `-n` sees a screen leave) and re-asserts only on a nodevice -> device transition,
# never on player start: it MUST NOT inherit the late pass's `systemctl try-restart`, which is
# right seconds after boot and wrong at 3 pm on a card nobody is standing next to. `tvservice -e`
# itself power-cycles the output, which can look like its own transition, so a watch pass never
# acts twice inside its suppression window, never past its rate limit, and never past its
# per-boot cap — belt, braces, and a backstop for a set that is genuinely flapping.
#
# Reads hdmi_group / hdmi_mode from the [pi3] block first (falls back to the first global
# ones); hdmi_drive=1 -> DVI signalling. No explicit mode in config.txt -> nothing to do.
CFG=/boot/config.txt; [ -f /boot/firmware/config.txt ] && CFG=/boot/firmware/config.txt
STATE=/run/hdmi-rehandshake.state
# watch-pass tuning: WSUPPRESS seconds between acts, at most WRATELIMIT acts in any
# WRATEWINDOW-second span, at most WMAXACTS acts total in one boot (tmpfs state -> resets on reboot).
WSTATE=/run/hdmi-rehandshake-watch.state
WACTS=/run/hdmi-rehandshake-watch.acts
WSUPPRESS=90; WRATEWINDOW=600; WRATELIMIT=3; WMAXACTS=20
LATE=0; WATCH=0; WAIT=20; DELAY=3
while [ $# -gt 0 ]; do case "$1" in --late) LATE=1 ;; --watch) WATCH=1 ;; --wait) WAIT=${2:-20}; shift ;; *) DELAY=$1 ;; esac; shift; done
blk=$(awk '/^\[pi3\]/{p=1;next} /^\[/{p=0} p' "$CFG" 2>/dev/null)
g=$(echo "$blk" | sed -n 's/^hdmi_group=\([0-9]*\).*/\1/p' | head -1)
m=$(echo "$blk" | sed -n 's/^hdmi_mode=\([0-9]*\).*/\1/p' | head -1)
[ -n "$g" ] || g=$(sed -n 's/^hdmi_group=\([0-9]*\).*/\1/p' "$CFG" | head -1)
[ -n "$m" ] || m=$(sed -n 's/^hdmi_mode=\([0-9]*\).*/\1/p' "$CFG" | head -1)
case "$g" in 1) G=CEA ;; 2) G=DMT ;; *) echo "hdmi-rehandshake: no explicit hdmi_group/hdmi_mode in $CFG, nothing to do"; exit 0 ;; esac
[ -n "$m" ] || { echo "hdmi-rehandshake: hdmi_group without hdmi_mode, nothing to do"; exit 0; }
d=$(grep -m1 '^hdmi_drive=' "$CFG" | cut -d= -f2); [ "$d" = 1 ] && D=DVI || D=HDMI
command -v tvservice >/dev/null || { echo "hdmi-rehandshake: no tvservice (KMS stack?), nothing to do"; exit 0; }
present() { tvservice -n 2>&1 | grep -q 'device_name='; }
assert_mode() {
  echo "hdmi-rehandshake: tvservice -e \"$G $m $D\" ($(tvservice -n 2>&1 | tr -d '\n'))"
  tvservice -e "$G $m $D"
  sleep 1
  # wake the framebuffer so what draws on it next lands on the fresh link
  fbset -depth 8 >/dev/null 2>&1; fbset -depth 32 >/dev/null 2>&1
  tvservice -s
}
if [ "$LATE" = 1 ]; then
  [ "$(cat $STATE 2>/dev/null)" = nodevice ] || { echo "hdmi-rehandshake: late pass, display was present at boot: nothing to do"; exit 0; }
  present || { echo "hdmi-rehandshake: late pass, still no display: nothing to do"; exit 0; }
  echo "hdmi-rehandshake: late pass, a display appeared after boot -> re-negotiate + restart the player"
  assert_mode
  echo device > $STATE
  systemctl try-restart 'hplayer2@*.service' 2>/dev/null || true
  exit 0
fi
if [ "$WATCH" = 1 ]; then
  now=$(date +%s)
  prev=$(cat "$WSTATE" 2>/dev/null || echo unknown)
  cur=nodevice; present && cur=device
  echo "$cur" > "$WSTATE"
  # only a display RETURNING is interesting — first tick after boot just seeds the state,
  # a display that stays present or stays absent is not this unit's job
  [ "$prev" = nodevice ] && [ "$cur" = device ] || exit 0
  # per-boot cap: a set that keeps needing this has a hardware problem, not a software one
  # (test existence first: `wc -l < missing-file` leaks its error past `2>/dev/null` — the
  # shell resolves the `<` redirect, and reports its own failure, before that redirect runs)
  acts=0; [ -f "$WACTS" ] && acts=$(wc -l < "$WACTS")
  if [ "$acts" -ge "$WMAXACTS" ]; then
    echo "hdmi-rehandshake: watch pass, display returned but $WMAXACTS acts already this boot: not acting again"
    exit 0
  fi
  # suppression window: tvservice -e power-cycles the output, which can look like its own
  # nodevice -> device transition to the very next poll
  last=0; [ -s "$WACTS" ] && last=$(tail -n1 "$WACTS")
  if [ $(( now - last )) -lt "$WSUPPRESS" ]; then
    echo "hdmi-rehandshake: watch pass, display returned but inside the ${WSUPPRESS}s suppression window ($(( now - last ))s since the last act): skipping"
    exit 0
  fi
  # rate limit: no more than WRATELIMIT acts in any WRATEWINDOW-second span, independent of
  # the per-act suppression window above (catches a slower flap the suppression alone would not)
  recent=$(awk -v since=$(( now - WRATEWINDOW )) '$1 >= since' "$WACTS" 2>/dev/null | wc -l)
  if [ "$recent" -ge "$WRATELIMIT" ]; then
    echo "hdmi-rehandshake: watch pass, display returned but $recent act(s) already in the last ${WRATEWINDOW}s (limit $WRATELIMIT): skipping"
    exit 0
  fi
  echo "hdmi-rehandshake: watch pass, a display returned during the day -> re-negotiate (no player restart)"
  assert_mode
  echo "$now" >> "$WACTS"
  exit 0
fi
sleep "$DELAY"
t0=$(date +%s)
while ! present; do
  [ $(( $(date +%s) - t0 )) -ge "$WAIT" ] && break
  sleep 2
done
if present; then echo device > $STATE; echo "hdmi-rehandshake: display present after $(( $(date +%s) - t0 )) s"
else echo nodevice > $STATE; echo "hdmi-rehandshake: no display after $WAIT s: asserting the mode anyway (late pass will retry)"; fi
assert_mode
