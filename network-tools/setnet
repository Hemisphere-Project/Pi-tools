#!/usr/bin/env python3
import sys, filecmp, os, syslog
from shutil import copyfile


TAG = 'setnet'

def log(msg):
    print(f"[{TAG}] {msg}")
    syslog.syslog(syslog.LOG_INFO, f"{TAG}: {msg}")


# Auto-detect boot partition (modern Pi OS uses /boot/firmware)
BOOT_DIR = '/boot/firmware' if os.path.isdir('/boot/firmware') else '/boot'
LOCALSOURCE = os.path.join(BOOT_DIR, 'wifi')
USBSOURCE = '/data/usb/wifi'
DEST = '/etc/NetworkManager/system-connections'
EXT = '.nmconnection'

engageRW = False


def rw_on():
    global engageRW
    if not engageRW:
        engageRW = True
        os.system('rw')


def rw_off():
    global engageRW
    if engageRW:
        os.system('sync')
        os.system('ro')
        engageRW = False


def syncFolder(src, dest, ext=''):
    global engageRW
    somethingChanged = False
    
    log("Syncing "+src+" to "+dest)
    
    if not os.path.isdir(src):
        print("  - Source path not found.. abort")
        return False
    
    srcList     = [f[:-len(ext)] for f in os.listdir(src)  if os.path.isfile(os.path.join(src, f))  and f.endswith(ext)]
    destList    = [f[:-len(ext)] for f in os.listdir(dest) if os.path.isfile(os.path.join(dest, f)) and f.endswith(ext)]
    
    print("  - Wanted files", srcList)
    print("  - Existing files", destList)
    
    # add/update new files
    for c in srcList:
        srcFile = os.path.join(src,c+ext)
        destFile = os.path.join(dest,c+ext)
        if not os.path.exists(srcFile):
            print('ERROR: file not found:', c)
        elif not os.path.exists(destFile) or not filecmp.cmp(srcFile, destFile, shallow=False):
            rw_on()
            copyfile(srcFile, destFile)
            print('  File updated:', c)
            somethingChanged = True
        else:
            print('  File valid:', c)
            
    # remove unused
    for e in destList:
        if not e in srcList:
            rw_on()
            try:
                os.remove(os.path.join(dest,e+ext))
            except FileNotFoundError:
                os.remove(os.path.join(dest,e))
            somethingChanged = True
            print('  File removed:', e)
            
    return somethingChanged


try:
    # copy profiles from usb
    syncFolder(USBSOURCE, LOCALSOURCE, EXT)
    print()

    # copy profiles to NM
    log("Applying profiles to NetworkManager")
    syncFolder(LOCALSOURCE, DEST, EXT)

    if engageRW:
        os.system('chmod 600 -R ' + DEST)
        rw_off()
        log('Restarting NetworkManager')
        os.system('systemctl restart NetworkManager')
finally:
    rw_off()

