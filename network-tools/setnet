#!/usr/bin/env python3
"""setnet — apply /boot/wifi NetworkManager profiles, then reconcile AP roles.

Two responsibilities, in order:

  1. Additive profile sync (unchanged): copy new/changed *.nmconnection from a
     USB stick into the boot source of truth, then from boot into NetworkManager.
     Never deletes — a stray source can't wipe the running config.

  2. AP-role reconcile (new, 2026-09): NetworkManager drives client/STA and
     ethernet as before, but a `type=wifi mode=ap` profile is NOT handed to
     NM's wpa_supplicant AP path — that path is unusable by Apple clients on the
     Broadcom fullmac chips (assoc + 4-way complete, then the STA's encrypted
     uplink never reaches the host, DHCP never happens, deauth ~6 s later). For
     every active AP profile we instead generate a hostapd config from the same
     .nmconnection and run `hostapd@<iface>`, with the interface set NM-unmanaged.
     The .nmconnection stays the single declarative source of truth, so hostrename
     (which rewrites `ssid=`) and the /boot/wifi file-drop role switch keep working
     unchanged: drop an AP profile in -> hostapd; swap it for a client profile ->
     the interface is handed back to NM and hostapd stops.
"""

import sys, os, glob, re, filecmp, syslog, subprocess, time
from shutil import copyfile


TAG = 'setnet'

def log(msg):
    print(f"[{TAG}] {msg}")
    syslog.syslog(syslog.LOG_INFO, f"{TAG}: {msg}")


# Auto-detect boot partition (modern Pi OS uses /boot/firmware)
BOOT_DIR = '/boot/firmware' if os.path.isdir('/boot/firmware') else '/boot'
LOCALSOURCE = os.path.join(BOOT_DIR, 'wifi')
USBSOURCE = '/data/usb/wifi'
DEST = '/etc/NetworkManager/system-connections'
EXT = '.nmconnection'
LEGACY = '_legacy'

HOSTAPD_DIR = '/etc/hostapd'
NM_CONFD = '/etc/NetworkManager/conf.d'
UNMANAGED_PREFIX = '50-hostapd-'   # /etc/NetworkManager/conf.d/50-hostapd-<iface>.conf

engageRW = False


def run(cmd, check=False):
    """Run a shell command, return (rc, stdout). Quiet by default."""
    r = subprocess.run(cmd, shell=True, text=True, capture_output=True)
    if check and r.returncode != 0:
        log(f"cmd failed ({r.returncode}): {cmd}\n{r.stderr.strip()}")
    return r.returncode, r.stdout.strip()


def rw_on():
    global engageRW
    if not engageRW:
        engageRW = True
        os.system('rw')


def rw_off():
    global engageRW
    if engageRW:
        os.system('sync')
        os.system('ro')
        engageRW = False


# -- 1. Additive profile sync ------------------------------------------------

def syncFolder(src, dest, ext='', archive=False):
    """Additive-only profile sync: copy new/changed files from src into dest.

    Never deletes anything already in dest — a profile added in the field (or a
    stray empty source) can never wipe the running config. When an incoming file
    differs from an existing one and archive=True, the superseded copy is moved
    aside into '<dest>/_legacy/' before the incoming version is applied, so the
    boot source of truth keeps a trail of what it replaced.
    """
    somethingChanged = False

    log("Syncing " + src + " to " + dest)

    if not os.path.isdir(src):
        print("  - Source path not found.. skip")
        return False
    if not os.path.isdir(dest):
        print("  - Destination path not found.. skip")
        return False

    srcList = [f for f in os.listdir(src)
               if f.endswith(ext) and os.path.isfile(os.path.join(src, f))]
    print("  - Incoming files", srcList)

    for name in srcList:
        srcFile = os.path.join(src, name)
        destFile = os.path.join(dest, name)

        if os.path.exists(destFile) and filecmp.cmp(srcFile, destFile, shallow=False):
            print('  valid   :', name)
            continue

        rw_on()

        # Archive the superseded copy before overwriting (incoming wins).
        if archive and os.path.exists(destFile):
            legacy_dir = os.path.join(dest, LEGACY)
            os.makedirs(legacy_dir, exist_ok=True)
            copyfile(destFile, os.path.join(legacy_dir, name))
            print('  archived:', os.path.join(LEGACY, name))

        copyfile(srcFile, destFile)
        print('  applied :', name)
        somethingChanged = True

    return somethingChanged


# -- 2. AP-role reconcile ----------------------------------------------------

def parse_profile(path):
    """Minimal INI parse of a .nmconnection (NM keyfile). Returns a flat dict
    keyed 'section.key', or None on read error."""
    d = {}
    section = ''
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith('#'):
                    continue
                if line.startswith('[') and line.endswith(']'):
                    section = line[1:-1]
                    continue
                if '=' in line:
                    k, v = line.split('=', 1)
                    d[f"{section}.{k.strip()}"] = v.strip()
    except OSError:
        return None
    return d


def profile_iface(prof, path):
    """Interface a profile targets: explicit interface-name, else the filename
    prefix before the first '-' (wint-hotspot -> wint, wlan0-sync-AP -> wlan0)."""
    iface = prof.get('connection.interface-name', '')
    if iface:
        return iface
    base = os.path.basename(path)[:-len(EXT)]
    return base.split('-', 1)[0] if '-' in base else base


def reg_country(default='FR'):
    _, out = run("iw reg get 2>/dev/null | grep -m1 country")
    m = re.search(r'country\s+([A-Z]{2})', out or '')
    return m.group(1) if m and m.group(1) != '00' else default


def hostapd_conf_from_profile(prof, iface):
    """Render a hostapd.conf string from an AP-mode .nmconnection dict."""
    ssid = prof.get('wifi.ssid', '')
    band = prof.get('wifi.band', 'bg')            # 'a' (5 GHz) or 'bg' (2.4 GHz)
    channel = prof.get('wifi.channel', '')
    hidden = prof.get('wifi.hidden', 'false').lower() in ('true', '1', 'yes')
    psk = prof.get('wifi-security.psk', '')
    pmf = prof.get('wifi-security.pmf', '')       # NM: 0/1(optional)/2(required)

    hw_mode = 'a' if band == 'a' else 'g'
    if not channel:
        channel = '36' if hw_mode == 'a' else '6'

    lines = [
        f"# generated by setnet from the {iface} AP profile — do not edit by hand",
        f"interface={iface}",
        "driver=nl80211",
        f"ssid={ssid}",
        f"country_code={reg_country()}",
        "ieee80211d=1",
        f"hw_mode={hw_mode}",
        f"channel={channel}",
        "ieee80211n=1",
        "wmm_enabled=1",
        "auth_algs=1",
        f"ignore_broadcast_ssid={1 if hidden else 0}",
    ]
    if psk:
        lines += [
            "wpa=2",
            "wpa_key_mgmt=WPA-PSK",
            "rsn_pairwise=CCMP",
            f"wpa_passphrase={psk}",
        ]
        # NM's pmf=1 means "optional/opportunistic" — its default, carried on the
        # fleet's profiles without anyone asking for PMF. On the Broadcom fullmac
        # stack, advertising PMF (ieee80211w) makes Apple clients flaky: association
        # fails and the Mac falls back to a known network — the same class of failure
        # the hostapd switch exists to fix. So treat optional PMF as off, and only
        # honour an explicit "required" (pmf=2), which a profile author opts into.
        if pmf == '2':
            lines.append("ieee80211w=2")
    return '\n'.join(lines) + '\n'


def scan_active_profiles():
    """Return ({iface: (prof, path)} for AP profiles, {iface} for wifi STA)."""
    ap, sta = {}, set()
    for path in glob.glob(os.path.join(DEST, '*' + EXT)):
        prof = parse_profile(path)
        if not prof or prof.get('connection.type') != 'wifi':
            continue
        iface = profile_iface(prof, path)
        if not iface:
            continue
        if prof.get('wifi.mode') == 'ap':
            # If several AP profiles target one iface, highest priority wins.
            prio = int(prof.get('connection.autoconnect-priority', '0') or 0)
            if iface not in ap or prio >= ap[iface][2]:
                ap[iface] = (prof, path, prio)
        else:
            sta.add(iface)
    return {i: (p, path) for i, (p, path, _) in ap.items()}, sta


def apply_ap(iface, prof):
    """Bring one interface up as a hostapd AP from its .nmconnection."""
    rw_on()
    os.makedirs(HOSTAPD_DIR, exist_ok=True)
    os.makedirs(NM_CONFD, exist_ok=True)

    conf = hostapd_conf_from_profile(prof, iface)
    with open(os.path.join(HOSTAPD_DIR, f"{iface}.conf"), 'w') as f:
        f.write(conf)

    # Static IP for the hostapd@.service ExecStartPre to apply.
    addr = prof.get('ipv4.address1', '').split(',')[0].strip()   # "10.0.0.1/24"
    with open(os.path.join(HOSTAPD_DIR, f"{iface}.ipaddr"), 'w') as f:
        f.write((addr or '') + '\n')

    # Take the interface away from NetworkManager (runtime + persistent).
    drop = os.path.join(NM_CONFD, f"{UNMANAGED_PREFIX}{iface}.conf")
    with open(drop, 'w') as f:
        f.write("# generated by setnet — this interface is a hostapd AP\n"
                "[keyfile]\n"
                f"unmanaged-devices=interface-name:{iface}\n")

    log(f"AP {iface}: ssid={prof.get('wifi.ssid','?')} "
        f"band={prof.get('wifi.band','?')} ch={prof.get('wifi.channel','auto')} -> hostapd")
    run(f"nmcli device set {iface} managed no", check=False)
    run(f"systemctl enable hostapd@{iface}", check=False)


def teardown_ap(iface):
    """Reverse an AP interface back to NetworkManager control."""
    log(f"AP {iface}: no active AP profile -> returning to NetworkManager")
    run(f"systemctl disable --now hostapd@{iface}", check=False)
    drop = os.path.join(NM_CONFD, f"{UNMANAGED_PREFIX}{iface}.conf")
    for p in (drop, os.path.join(HOSTAPD_DIR, f"{iface}.conf"),
              os.path.join(HOSTAPD_DIR, f"{iface}.ipaddr")):
        if os.path.exists(p):
            rw_on()
            os.remove(p)
    run(f"nmcli device set {iface} managed yes", check=False)


def configured_ap_ifaces():
    """Interfaces we previously set up as hostapd APs (by their unmanaged drop-in)."""
    ifaces = set()
    for p in glob.glob(os.path.join(NM_CONFD, f"{UNMANAGED_PREFIX}*.conf")):
        ifaces.add(os.path.basename(p)[len(UNMANAGED_PREFIX):-len('.conf')])
    return ifaces


def present_ifaces():
    """Network interfaces that currently exist on the host."""
    try:
        return set(os.listdir('/sys/class/net'))
    except OSError:
        return set()


def reconcile_roles():
    """Make the running AP/STA topology match the active NM profiles.

    Only interfaces that currently exist are configured: an AP profile for an
    absent device (e.g. the optional wlan0 sync dongle on a player that has none)
    stays dormant, and reconfigures itself if that device later appears.
    """
    ap, sta = scan_active_profiles()
    present = present_ifaces()
    ap = {iface: v for iface, v in ap.items() if iface in present}
    previously = configured_ap_ifaces()

    # Reverse any interface we previously set up that no longer has (or can host)
    # an active AP profile — including a dongle that has since been unplugged.
    for iface in previously - set(ap):
        teardown_ap(iface)

    if not ap:
        if previously:
            os.system('nmcli connection reload')
        return

    for iface, (prof, _path) in ap.items():
        apply_ap(iface, prof)

    # NM must re-read the unmanaged drop-ins before we (re)start hostapd.
    os.system('nmcli connection reload')

    for iface in ap:
        run(f"systemctl restart hostapd@{iface}", check=False)
        if iface not in previously:
            # Fresh handover from NetworkManager. On the Broadcom fullmac chips the
            # first hostapd start after wpa_supplicant's AP teardown comes up stale:
            # AP-ENABLED and beaconing, yet every association is rejected (status 38)
            # and the kernel logs `brcmf_vif_set_mgmt_ie: vndr ie set error : -52`.
            # One more full stop/start cycle (hostapd@.service bounces the link in
            # its ExecStartPre) leaves the firmware consistent. A link bounce alone
            # does not. Seen on player-36 and player-37 (RPi 3B+), 2026-09-03.
            time.sleep(3)
            run(f"systemctl restart hostapd@{iface}", check=False)

    # dnsmasq serves the AP subnets; rebind now that the AP IPs are up.
    run("systemctl restart dnsmasq", check=False)


# -- main --------------------------------------------------------------------

try:
    # 1. Pull profiles from a USB stick into the boot source of truth.
    #    Incoming wins; the superseded local copy is archived to _legacy.
    syncFolder(USBSOURCE, LOCALSOURCE, EXT, archive=True)
    print()

    # 2. Apply the boot profiles to NetworkManager (additive; never deletes).
    log("Applying profiles to NetworkManager")
    syncFolder(LOCALSOURCE, DEST, EXT)

    if engageRW:
        os.system('chmod 600 -R ' + DEST)

    # 3. Reconcile AP roles: hostapd for mode=ap, NetworkManager for the rest.
    log("Reconciling AP roles")
    reconcile_roles()

    if engageRW:
        rw_off()
        log('Reloading NetworkManager connections')
        os.system('nmcli connection reload')
finally:
    rw_off()

log('done !')
