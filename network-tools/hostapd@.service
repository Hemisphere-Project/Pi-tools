[Unit]
Description=hostapd AP on %i (Pi-tools; config generated by setnet from the NM profile)
Documentation=man:hostapd(8)
# The interface is NetworkManager-unmanaged (setnet writes a conf.d drop-in), so
# start after NM is up and has read that drop-in. setnet also restarts this unit
# explicitly after it reconciles, so first-apply ordering does not rely on boot order.
After=NetworkManager.service
Wants=NetworkManager.service
ConditionPathExists=/etc/hostapd/%i.conf

[Service]
Type=simple
# Bring the interface up and apply the static AP address parsed from the profile.
ExecStartPre=/bin/sh -c 'ip link set %i up || true; if [ -s /etc/hostapd/%i.ipaddr ]; then ip addr replace "$(cat /etc/hostapd/%i.ipaddr)" dev %i; fi'
ExecStart=/usr/sbin/hostapd /etc/hostapd/%i.conf
ExecStopPost=/bin/sh -c 'if [ -s /etc/hostapd/%i.ipaddr ]; then ip addr del "$(cat /etc/hostapd/%i.ipaddr)" dev %i 2>/dev/null || true; fi'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
