[connection]
id=hotspot-wint
type=wifi
autoconnect=true
autoconnect-priority=9
interface-name=wint

[wifi]
hidden=false
mode=ap
band=a
channel=36
ssid=rasta-00

[wifi-security]
key-mgmt=wpa-psk
proto=rsn
pairwise=ccmp
group=ccmp
pmf=1
psk=Rastapi69*

[ipv4]
address1=10.0.0.1/24,10.0.0.1
method=manual

[ipv6]
addr-gen-mode=stable-privacy
method=ignore
