[Unit]
Description=journal-export: append the journal since the last run to /data (sequential, one fsync)
ConditionPathIsDirectory=/data

[Service]
Type=oneshot
# No ExecCondition= here (Pi-tools HEAD has one; systemd 241 on the players would ignore it anyway):
# the 29/09 journal-export gates internally — blackbox archive always, journal part only while
# `diag armed` (one hour of the budget per armed run).
ExecStart=/usr/local/bin/journal-export
Nice=10
