[Unit]
Description=journal-export hourly, only while diagnostics are armed (diag arm)

[Timer]
# hourly (was 10 min, 2026-09-27): /data sees one sequential append per hour; a power cut
# costs at most the last hour of trail. An anomaly still dumps at once (journal-export --now).
# OnCalendar (absolute), not OnUnitActiveSec: the service is skipped by `diag armed` most hours,
# and a relative timer must never depend on how systemd counts a skipped run.
OnCalendar=hourly
AccuracySec=30s
Unit=journal-export.service

[Install]
WantedBy=timers.target
