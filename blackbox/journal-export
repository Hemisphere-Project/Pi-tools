#!/bin/bash
# journal-export — the post-mortem trail on /data, written the way an SD card tolerates, and
# BOUNDED BY CONSTRUCTION (v4, 2026-09-29, MBA garden).
#
# journald stays in RAM (journald-ram.conf). Every hour (timer) this script:
#   1. ALWAYS appends the blackbox's live per-minute line (/run/blackbox.log) to
#      /data/var/log/blackbox.log — one sequential append + one fsync, ~500 B/min (~0.7 MB/day).
#      This is the record every diagnosis so far stood on; it is deliberately not gated.
#   2. ONLY WHILE `diag armed` (one armed hour consumed per run): appends the journal lines logged
#      since the previous run to journal-export/<date>.log — STREAMED, never held in a variable
#      (the v3b variable version invoked the OOM killer on W1, 2026-09-29 02:03), the NEWEST
#      LINES_CAP entries at most (a storm's older lines are skipped, one marker line says so),
#      RUN_CAP bytes at most, DAY_CAP_MB per day at most, then a marker and silence until midnight.
#   3. Anomaly dump (`--now <reason>`, called by blackbox, ≤ 1 per 15 min, only while armed):
#      the last 60 blackbox lines + 15 min of journal, DUMP_CAP bytes at most.
# Nothing here uses /tmp or /data/tmp for scratch (TMPDIR=/run). The cursor lives in /run: the
# RAM journal does not survive a reboot, so neither should the cursor (a stale cursor made the
# v3b script export nothing after some reboots). Pruning never deletes today's file.
# Worst case per day while armed: 24 × RUN_CAP + 20 dumps ≈ well under 100 MB, typically < 25 MB;
# disarmed: the blackbox archive only.
set -u
OUT=${JOURNAL_EXPORT_DIR:-/data/var/log/journal-export}
CUR=/run/journal-export.cursor
SCRATCH=/run/journal-export.tmp
LINES_CAP=${JOURNAL_EXPORT_LINES:-15000}        # newest entries per run
RUN_CAP=${JOURNAL_EXPORT_RUN_BYTES:-4194304}     # 4 MB per run
DAY_CAP_MB=${JOURNAL_EXPORT_DAY_MB:-24}
DUMP_CAP=${JOURNAL_EXPORT_DUMP_BYTES:-1048576}   # 1 MB per dump
MAX_MB=${JOURNAL_EXPORT_MAX_MB:-300}
KEEP_DAYS=${JOURNAL_EXPORT_KEEP_DAYS:-14}
DUMPS_KEEP=20
export TMPDIR=/run
[ -d /data ] || exit 0
mkdir -p "$SCRATCH" 2>/dev/null

log() { logger -t journal-export "$*" 2>/dev/null || true; }

armed() { command -v diag >/dev/null 2>&1 && diag armed "$@" >/dev/null 2>&1; }

# 1. blackbox live line -> archive (v3b contract: byte offset in /run/blackbox.exported, reset to
#    EMPTY by blackbox on rotation — the v3b script choked on that empty file and froze the archive
#    until reboot: W3 lost 25-28/09. Anything non-numeric reads as 0.)
bb_archive() {
  local live=/run/blackbox.log arch=/data/var/log/blackbox.log off size
  [ -f "$live" ] || return 0
  off=$(cat /run/blackbox.exported 2>/dev/null); [[ "$off" =~ ^[0-9]+$ ]] || off=0
  size=$(stat -c %s "$live" 2>/dev/null) || return 0
  [ "$off" -gt "$size" ] && off=0
  [ "$size" -gt "$off" ] || return 0
  mkdir -p "$(dirname "$arch")" 2>/dev/null
  if tail -c +$((off+1)) "$live" >> "$arch"; then
    echo "$size" > /run/blackbox.exported
    sync -d "$arch" 2>/dev/null || true
  fi
}

# newest cursor of the RAM journal, cheaply (no body)
tail_cursor() { journalctl -n 1 --show-cursor -o cat --no-pager 2>/dev/null | grep -oE '^-- cursor: .*' | tail -1 | sed 's/^-- cursor: //'; }

# 2. journal -> today's file, streamed and capped
journal_part() {
  local F T C n today size
  today=$(date +%F); F=$OUT/$today.log; T=$SCRATCH/out.$$
  mkdir -p "$OUT" 2>/dev/null || return 0
  size=$(stat -c %s "$F" 2>/dev/null || echo 0)
  if [ "$size" -ge $((DAY_CAP_MB * 1024 * 1024)) ]; then
    if [ ! -f "/run/journal-export.daycap.$today" ]; then
      echo "-- journal-export: daily cap ${DAY_CAP_MB} MB reached at $(date '+%T'); nothing more today" >> "$F"
      sync -d "$F" 2>/dev/null || true
      touch "/run/journal-export.daycap.$today"; log "daily cap ${DAY_CAP_MB} MB reached"
    fi
    C=$(tail_cursor); [ -n "$C" ] && printf '%s' "$C" > "$CUR"   # keep walking, keep the card quiet
    return 0
  fi
  if [ -s "$CUR" ]; then
    nice journalctl --after-cursor="$(cat "$CUR")" -n "$LINES_CAP" --show-cursor -o short-iso --no-pager > "$T" 2>/dev/null
  else
    nice journalctl -n "$LINES_CAP" --show-cursor -o short-iso --no-pager > "$T" 2>/dev/null
  fi
  C=$(grep -oE '^-- cursor: .*' "$T" | tail -1 | sed 's/^-- cursor: //')
  n=$(grep -vc '^-- ' "$T" 2>/dev/null || echo 0)
  if [ "$n" -gt 0 ]; then
    { [ "$n" -ge "$LINES_CAP" ] && echo "-- journal-export: $LINES_CAP-line cap hit, older lines of this run skipped ($(date '+%T'))"
      grep -vE '^-- (cursor: |Logs begin)' "$T" | head -c "$RUN_CAP"
      echo; } >> "$F"
    sync -d "$F" 2>/dev/null || true
  fi
  [ -n "$C" ] && printf '%s' "$C" > "$CUR"
  rm -f "$T"
  # prune: older than KEEP_DAYS, then the oldest until under MAX_MB — never today's file
  find "$OUT" -maxdepth 1 -name '*.log' -mtime +"$KEEP_DAYS" ! -name "$today.log" -delete 2>/dev/null
  while [ "$(du -sm "$OUT" 2>/dev/null | cut -f1)" -gt "$MAX_MB" ]; do
    local o; o=$(ls -t "$OUT"/*.log 2>/dev/null | tail -1)
    [ -n "$o" ] && [ "$o" != "$F" ] || break
    rm -f "$o"
  done
}

case "${1:-}" in
  --now|dump)
    bb_archive
    armed --peek || exit 0
    D=$OUT/dumps; mkdir -p "$D" 2>/dev/null || exit 0
    T=$D/$(date +%F_%H%M%S)-${2:-anomaly}.log
    { echo "### blackbox, last 60 lines"; tail -n 60 /run/blackbox.log 2>/dev/null
      echo "### journal, last 15 min"; nice journalctl --since -15min -o short-iso --no-pager 2>/dev/null; } | head -c "$DUMP_CAP" > "$T"
    sync -d "$T" 2>/dev/null || sync
    ls -t "$D" 2>/dev/null | tail -n +$((DUMPS_KEEP + 1)) | while read -r f; do rm -f "$D/$f"; done
    echo "journal-export: dump $T ($(wc -l < "$T") lines)"; exit 0 ;;
  status)
    echo "dir $(du -sm "$OUT" 2>/dev/null | cut -f1) MB, files: $(ls "$OUT"/*.log 2>/dev/null | wc -l), dumps: $(ls "$OUT/dumps" 2>/dev/null | wc -l), cursor: $([ -s "$CUR" ] && echo yes || echo none), last: $(ls -t "$OUT"/*.log 2>/dev/null | head -1), diag: $(diag status 2>/dev/null || echo 'no diag'), blackbox archive: $(stat -c %s /data/var/log/blackbox.log 2>/dev/null || echo 0) B"; exit 0 ;;
  bb-only)
    bb_archive; exit 0 ;;
esac

bb_archive
armed || exit 0        # consumes one armed hour; disarmed = the card saw only the blackbox append
journal_part
exit 0
