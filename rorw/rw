#!/bin/bash

TESTFILE="/root/.readonly"

sync
for i in {1..5}; do
	echo "RW - Attempt $i:"
	
    # Try to remount the root filesystem as read-write
    mount -o remount,rw /

    # Try to remount the boot partition as read-write.
    # Mountpoint-driven: covers Pi (/boot or /boot/firmware) and any EFI
    # system (/boot/efi on mmc, sda, nvme — the old device probe missed
    # x86, leaving /boot/efi ro under `rw` and breaking grub updates).
    if mountpoint -q /boot/firmware; then
        mount -o remount,rw /boot/firmware
    elif mountpoint -q /boot/efi; then
        mount -o remount,rw /boot/efi
    elif mountpoint -q /boot; then
        mount -o remount,rw /boot
    fi

	if touch "$TESTFILE" 2>/dev/null; then
		echo "=> RW ok!"
        sync
        exit 0
	else
		echo "RW Failed. Unable to touch file /boot/VERSION, trying again..."
		sleep 1  # Wait a second before the next attempt
	fi
done
echo "=> RW Failed after 5 attempts. Exiting."
exit 1