#!/bin/bash
# One-shot clock set from an HTTP Date header — for no-RTC boxes where NTP
# (udp/123) is blocked but HTTPS passes. fake-clock is the boot-time floor; this
# nudges the clock forward whenever a network is reachable. Run by datesync.timer.

# -f fail on HTTP errors, -s silent, -m 5 hard 5s timeout (never hang a boot),
# -I head only. HTTPS so a plain on-path box can't trivially set our clock.
header=$(curl -fsm 5 -I https://www.google.com 2>/dev/null | grep -i '^date:' | head -1)

# Bogus-clock escape: a VIRGIN RTC hands the kernel 2000-01-01 at boot
# (hctosys runs after fake-clock and clobbers its floor), and from year
# 2000 TLS validation can never succeed ("certificate not yet valid") —
# datesync would deadlock forever. When the local clock is plainly
# implausible, retry without cert validation: TLS trust is void under a
# wrong clock anyway, and the plausibility floor below still rejects
# garbage answers.
if [ -z "$header" ] && [ "$(date +%Y)" -lt 2021 ]; then
    header=$(curl -ksm 5 -I https://www.google.com 2>/dev/null | grep -i '^date:' | head -1)
    [ -n "$header" ] && echo "[datesync] local clock implausible — accepted Date without cert validation"
fi

remote=$(printf '%s' "${header#[Dd]ate:}" | tr -d '\r' | sed 's/^ *//')

if [ -z "$remote" ]; then
    echo "[datesync] no Date header (offline or blocked) — leaving clock as-is"
    exit 0
fi

# Sanity floor: reject a clearly bogus year (epoch reset, captive-portal garbage).
year=$(date -d "$remote" +%Y 2>/dev/null)
if [ -z "$year" ] || [ "$year" -lt 2025 ]; then
    echo "[datesync] rejecting implausible date: '$remote'"
    exit 1
fi

# Deadband: the HTTP Date header has 1 s resolution, so every `date -s` is a
# hard step of up to ~1 s (measured -0.24 s on player-000, 2026-09-04). A
# Zyre/wallclock-synced parc chases every step on every slave: the peer
# clockshift is re-sampled only every 120 s, so each run costs two speed
# excursions per online player. The clock only needs to be right to the minute
# (schedules, logs), so leave it alone unless it is off by more than DEADBAND
# seconds. The fake-clock floor is still refreshed so an offline reboot keeps
# the newest time we saw.
DEADBAND=${DATESYNC_DEADBAND:-3}
remote_s=$(date -d "$remote" +%s 2>/dev/null)
local_s=$(date +%s)
if [ -n "$remote_s" ]; then
    delta=$((remote_s - local_s))
    if [ "${delta#-}" -le "$DEADBAND" ]; then
        echo "[datesync] clock within ${delta}s of remote — leaving it alone"
        command -v fake-clock >/dev/null 2>&1 && fake-clock save 2>/dev/null || true
        exit 0
    fi
fi

if date -s "$remote" >/dev/null; then
    echo "[datesync] clock set to $remote"
    # Persist as the fake-clock floor so a later offline boot keeps this time.
    command -v fake-clock >/dev/null 2>&1 && fake-clock save 2>/dev/null || true
    # Program the RTC: a virgin module keeps reporting 2000 at every boot
    # until someone writes it — make any online moment permanent.
    [ -e /dev/rtc0 ] && hwclock -w 2>/dev/null || true
fi
