#!/bin/bash
# HPlayer2 audio hub forwarder — one per output, run by hplayer-audio@.service
#
#   hplayer-audio-fwd jack|hdmi|usb
#
# Reads the target latency from /etc/hplayer-audio.conf and execs an alsaloop
# from the shared dsnoop capture (aloopcap) to the sink's egress PCM. The usb
# variant first waits for a USB audio card to appear and picks the egress by
# playback width; on unplug alsaloop exits and systemd's Restart=always brings
# us back to the wait loop — that IS the hotplug mechanism.

CONF=/etc/hplayer-audio.conf
SINK="$1"

LAT=$(sed -n 's/^latency_us=\([0-9]\+\).*/\1/p' "$CONF" 2>/dev/null | head -1)
LAT=${LAT:-30000}
if [ "$LAT" -lt 20000 ]; then
    echo "latency_us=$LAT below the bcm2835 floor, clamping to 20000"
    LAT=20000
fi

case "$SINK" in
    jack) DEV="jackout" ;;
    hdmi) DEV="hdmiout" ;;
    usb)
        while true; do
            LINE=$(grep -m1 'USB-Audio' /proc/asound/cards)
            if [ -n "$LINE" ]; then
                IDX=$(echo "$LINE" | awk '{print $1}')
                CARD=$(echo "$LINE" | sed -n 's/^ *[0-9]* *\[\([^ ]*\) *\].*/\1/p')
                [ -n "$CARD" ] && break
            fi
            sleep 2
        done
        CH=$(awk '/^Playback:/{p=1} /^Capture:/{p=0} p && /Channels:/ {if ($2+0>c) c=$2+0} END{print c+0}' \
                 "/proc/asound/card$IDX/stream0" 2>/dev/null)
        if [ "${CH:-0}" -ge 8 ]; then
            DEV="usbout8:CARD=$CARD"
        else
            DEV="usbout2:CARD=$CARD"
        fi
        echo "usb card: $CARD (${CH:-?}ch) -> $DEV"
        ;;
    *)  echo "usage: hplayer-audio-fwd jack|hdmi|usb"; exit 2 ;;
esac

exec /usr/bin/alsaloop -C aloopcap -P "$DEV" -r 48000 -f S16_LE -c 8 -t "$LAT" -S auto
