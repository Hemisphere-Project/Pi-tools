#!/usr/bin/env bash
# burn-batch — clone ONE golden image onto N SD cards from the bench, and
# prove every card byte-for-byte before it leaves the table.
#
# Rolling a card lot is not `dd` in a loop. Each phase below exists because
# skipping it produces a card that looks burned and does not boot.
#
#   1. fsck the IMAGE first, once, before it is cloned N times — an unreplayed
#      /data journal is replayed by every clone at first boot, the rw/ro helper's
#      vfat dirty bit inherited by all. Checked read-only, REPAIRED only on a
#      finding: a clean golden stays byte-identical (sha256, mtime) every burn.
#   2. take the cards back off the desktop — udisks automounts every inserted
#      card read-write, and writing under it dirties what you just wrote.
#   3. dd in parallel, CAPPED — a bus-powered hub dropped all five of its
#      readers at once at six parallel writes (2026-09-10, 16-card LEA batch).
#   4. cmp EVERY card against the image. A reused card can silently fail the
#      write in its most-worn zone (the first ~260 MB, where its previous FAT
#      lived): the burn "completes", the rootfs is correct, and /boot keeps a
#      foreign volume id. Nothing but this pass catches it.
#
# Targets are resolved by READER SERIAL at run time, never by a /dev/sdX noted
# earlier: device names shuffle after a hub reset, and with several cards in,
# /dev/disk/by-label points at one arbitrary card.
#
#   Usage: burn-batch [-n] [-j N] [-y] [--no-fsck] IMAGE [TARGET ...]
#     TARGET   a reader serial (preferred) or a /dev node, which is pinned to
#              its serial immediately. Default: every card the readers hold.
#     -l       list the readers, their serials and their USB port paths, exit
#     -n       dry run: plan, refuse, report — write nothing, need no root.
#              With --fsck-only: the image is checked on a READ-ONLY loop
#              (losetup -r — root, still) and the repairs it needs are named,
#              never made.
#     -j N     parallel writes (default 3 — the hub is the ceiling, not the
#              reader count)
#     -y       skip the confirmation (for an unattended re-run)
#     --no-fsck    skip phase 1, the image is already known clean
#     --fsck-only  phase 1 ALONE — clean a golden image and stop, no cards
#                  involved. Worth running once on an image you are about to
#                  archive, so every future batch starts from a clean one.
#                  `-n --fsck-only` asks whether it is clean and writes nothing.
#     --flightbox  phase 5: on every card that verified, lay out flightbox's
#                  raw ring partition (p4, 512 MB) at the card's TAIL with
#                  image/flightbox-p4 — after the cmp, because it rewrites the
#                  partition table the cmp just proved. The RastaOS 7.5 burn:
#                  an image from before Pi-tools d17d886 (7.3, 7.4) gets no p4
#                  — its extendfs would grow p4, not /data — and the plan says
#                  so before the confirmation; its cards burn as file-mode cards.
#     --content IMAGE [DISK ...]   print what the image and each DISK (a /dev
#                  node or an image file) hold — the plan's CONTENT column —
#                  and exit. Writes nothing.
#
#   The plan prints what each card HOLDS before anything is written, -y or not:
#   per partition its filesystem, label (else volume id) and space in use. A
#   card whose layout is not the image's is flagged — read it before you burn.
#
#   BURNBATCH_LOG=<path>   CSV outcome log (default ~/burn-batch.csv)
#
# Root, once: the whole run is a single root phase on purpose, so a desktop
# session raises ONE graphical prompt.
#
#   ./bench/burn-batch -n ~/RPi-images/RastaOS-7.3.img        # plan it first
#   pkexec bash bench/burn-batch /home/me/RPi-images/RastaOS-7.3.img
#
# NOT in scope: per-card identity. This tool clones and proves; it never stamps
# a hostname, a role or a config.txt. Which card becomes which player is
# per-engagement and belongs in that engagement's runbook — `sd-converge` is
# the no-reflash path, the fleet prep scripts are the stamping one.
set -uo pipefail

usage() { sed -n '2,67p' "$0" | sed 's/^# \?//'; }

C_OK=$'\033[1;32m'; C_ERR=$'\033[1;31m'; C_WARN=$'\033[1;33m'; C_END=$'\033[0m'
say()  { echo "  $*"; }
ok()   { echo "${C_OK}  $*${C_END}"; }
warn() { echo "${C_WARN}  $*${C_END}"; }
err()  { echo "${C_ERR}  $*${C_END}"; }

ORIG_ARGS=("$@")
DRY=0; JOBS=3; YES=0; FSCK=1; LIST=0; FSCK_ONLY=0; P4=0; CONTENT_ONLY=0
while [ $# -gt 0 ]; do
    case "$1" in
        -n|--dry-run) DRY=1 ;;
        --content)    CONTENT_ONLY=1 ;;
        -j|--jobs)    JOBS="${2:?-j needs a count}"; shift ;;
        -y|--yes)     YES=1 ;;
        -l|--list)    LIST=1 ;;
        --no-fsck)    FSCK=0 ;;
        --fsck-only)  FSCK_ONLY=1 ;;
        --flightbox)  P4=1 ;;
        -h|--help)    usage; exit 0 ;;
        --)           shift; break ;;
        -*)           err "unknown option: $1"; usage; exit 2 ;;
        *)            break ;;
    esac
    shift
done
case "$JOBS" in ''|*[!0-9]*|0) err "-j wants a positive integer, got '$JOBS'"; exit 2 ;; esac

# The invoking human, whoever we are running as: pkexec scrubs SUDO_USER but
# sets PKEXEC_UID, and both are absent on a plain root shell.
INVOKER="${SUDO_USER:-}"
[ -z "$INVOKER" ] && [ -n "${PKEXEC_UID:-}" ] && INVOKER=$(getent passwd "$PKEXEC_UID" | cut -d: -f1)
[ -z "$INVOKER" ] && INVOKER="${USER:-root}"
INVOKER_HOME=$(getent passwd "$INVOKER" | cut -d: -f6)
LOG="${BURNBATCH_LOG:-${INVOKER_HOME:-/tmp}/burn-batch.csv}"

# ── the readers, as they are RIGHT NOW ───────────────────────────────────────
# A multi-slot reader exposes every slot as a disk and never removes the node
# when a card is pulled, so presence is MEDIUM presence (size > 0), not a node.
# A slot that enumerates at 0 B is an unseated card, not a dead one — reseat it
# before concluding anything.

udev_prop() {   # udev_prop <disk> <PROPERTY>
    udevadm info --query=property --name="/dev/$1" 2>/dev/null \
        | sed -n "s/^$2=//p" | head -1
}

serial_of() {   # serial_of <disk> -> reader serial, "" if it has none
    local s; s=$(udev_prop "$1" ID_SERIAL_SHORT)
    [ -z "$s" ] && s=$(udev_prop "$1" ID_SERIAL)
    echo "$s"
}

port_of() {     # port_of <disk> -> the physical USB port path, to label the slot
    udevadm info -q path --name="/dev/$1" 2>/dev/null \
        | sed -n 's|.*/usb[0-9]*/\([0-9.-]*\)/.*|\1|p' | head -1
}

size_of()  { cat "/sys/block/$1/size" 2>/dev/null || echo 0; }   # 512-B sectors
bytes_of() { echo $(( $(size_of "$1") * 512 )); }
human()    { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1"; }

all_disks() { ls /sys/block 2>/dev/null | grep -E '^(sd|mmcblk|nvme)' || true; }

disks_with_medium() {
    local d
    for d in $(all_disks); do [ "$(size_of "$d")" -gt 0 ] 2>/dev/null && echo "$d"; done
    return 0
}

# Re-resolve a serial to whatever /dev node holds it NOW. Called again
# immediately before the write and again before the verify: a hub reset in
# between renames the nodes, and that is exactly how a batch lands on the wrong
# card. Several matches are returned space-separated — the caller refuses them.
dev_for_serial() {  # dev_for_serial <serial> -> disk name(s); 1 if none
    local want="$1" d hits=""
    for d in $(disks_with_medium); do
        [ "$(serial_of "$d")" = "$want" ] && hits="$hits $d"
    done
    set -- $hits
    [ $# -eq 0 ] && return 1
    echo "$*"
}

# ── what a card HOLDS — the plan's CONTENT column ────────────────────────────
# DEVICE / SERIAL / SIZE say WHICH card, never what is on it. A 30 GB card of
# six music tracks once sat where a RastaOS spare was expected, and a wrapper
# passing -y never reaches the confirmation (2026-11-16). So the plan reads,
# per partition, its filesystem, label (else volume id) and space in use:
#
#     vfat boot 31M · ext4 rootfs 2.1G · ext4 data 12M     a RastaOS card
#     vfat 5B78-FD87 114M                                  somebody's music
#
# From the bytes, not from udev: the partition table with sfdisk, each
# filesystem with `blkid -p` at its offset, the space in use from the
# filesystem's own counters (ext*: the superblock, through debugfs; vfat: the
# FAT, counted) — or from the mount, when the desktop mounted it. Every read
# works on an image file too, which is how bench/burn-content-desk.sh proves
# it. A disk this user cannot read (-n without root) falls back to what udev
# saw: type and label, space in use only if mounted. Read-only throughout.

clean_name() { sed 's/[[:cntrl:]|]//g'; }  # a foreign label is printed: no escapes, no field separator

read_at() {     # read_at <path> <byte offset> <bytes> — dd seeks, od -j would READ its way there
    dd if="$1" iflag=skip_bytes,count_bytes skip="$2" count="$3" bs=1M status=none 2>/dev/null
}

ext_used() {    # ext_used <path> <byte offset> -> bytes in use, df's arithmetic
    debugfs -c -R 'stats -h' "$1?offset=$2" 2>/dev/null | awk -F: '
        /^Block count:/ {n=$2} /^Free blocks:/ {f=$2} /^Overhead clusters:/ {o=$2} /^Block size:/ {b=$2}
        END { if (b > 0 && n > 0) printf "%.0f\n", (n - f - o) * b }'
}

fat_used() {    # fat_used <path> <byte offset> -> bytes in use, df's arithmetic
    # Counted from the FAT itself, not from FSInfo's free count — a hint other
    # systems leave stale. FAT12 is skipped: no card this tool meets has it.
    local f="$1" o="$2" b bps spc rsv nfat tot fsz clusters w
    b=($(read_at "$f" "$o" 40 | od -An -v -tu1))
    [ ${#b[@]} -eq 40 ] || return 0
    bps=$(( b[11] | b[12] << 8 )); spc=${b[13]}; rsv=$(( b[14] | b[15] << 8 )); nfat=${b[16]}
    tot=$(( b[19] | b[20] << 8 )); fsz=$(( b[22] | b[23] << 8 ))
    [ "$tot" -eq 0 ] && tot=$(( b[32] | b[33] << 8 | b[34] << 16 | b[35] << 24 ))
    [ "$fsz" -eq 0 ] && fsz=$(( b[36] | b[37] << 8 | b[38] << 16 | b[39] << 24 ))
    [ "$bps" -gt 0 ] && [ "$spc" -gt 0 ] || return 0
    clusters=$(( (tot - rsv - nfat * fsz - ((b[17] | b[18] << 8) * 32 + bps - 1) / bps) / spc ))
    if [ "$clusters" -lt 4085 ]; then return 0
    elif [ "$clusters" -lt 65525 ]; then w=2; else w=4; fi
    [ $(( clusters * w )) -le 33554432 ] || return 0   # a FAT over 32 MB: too slow for a plan
    # entries 0 and 1 are reserved; every non-zero entry after them is a cluster in use
    echo $(( $(read_at "$f" $(( o + rsv * bps + 2 * w )) $(( clusters * w )) \
                | od -An -v -w$w -tx$w | grep -c '[1-9a-f]') * spc * bps ))
}

mounted_used() {  # mounted_used <disk> <start, 512-B sectors> -> bytes in use, if that partition is mounted
    local c
    for c in /sys/block/"$1"/"$1"*; do
        [ "$(cat "$c/start" 2>/dev/null)" = "$2" ] || continue
        lsblk -bndo FSUSED "/dev/${c##*/}" 2>/dev/null | tr -d ' '
        return 0
    done
}

part_of() {     # part_of <path> <byte offset> [<bytes>] -> "fstype|label|uuid|used"
    local f="$1" o="$2" sz=() probe t l u used=""
    [ -n "${3:-}" ] && sz=(-S "$3")
    probe=$(blkid -p -O "$o" ${sz[@]+"${sz[@]}"} -o export "$f" 2>/dev/null)
    t=$(sed -n 's/^TYPE=//p' <<<"$probe" | clean_name)
    l=$(sed -n 's/^LABEL=//p' <<<"$probe" | sed 's/\\\(.\)/\1/g' | clean_name)
    u=$(sed -n 's/^UUID=//p' <<<"$probe" | clean_name)
    [ -b "$f" ] && used=$(mounted_used "${f##*/}" $(( o / 512 )))
    if [ -z "$used" ]; then
        case "$t" in
            ext2|ext3|ext4) used=$(ext_used "$f" "$o") ;;
            vfat)           used=$(fat_used "$f" "$o") ;;
        esac
    fi
    echo "${t:-raw}|$l|$u|$used"
}

parts_udev() {  # parts_udev <disk> -> part_of lines from udev's view: no read access needed
    local d="$1" c t nodes=()
    for c in /sys/block/"$d"/"$d"*; do [ -e "$c/partition" ] && nodes+=("${c##*/}"); done
    [ ${#nodes[@]} -eq 0 ] && nodes=("$d")
    for c in "${nodes[@]}"; do
        t=$(lsblk -ndo FSTYPE "/dev/$c" 2>/dev/null | clean_name)
        [ "$c" = "$d" ] && [ -z "$t" ] && continue      # a bare disk: nothing on it
        echo "${t:-raw}|$(lsblk -ndo LABEL "/dev/$c" 2>/dev/null | clean_name)|$(lsblk -ndo UUID "/dev/$c" 2>/dev/null | clean_name)|$(lsblk -bndo FSUSED "/dev/$c" 2>/dev/null | tr -d ' ')"
    done
}

parts_of() {    # parts_of <disk: /dev node or image file> -> one part_of line per partition
    local f dump ss start size ptype whole any=0
    f=$(readlink -f "$1")
    if [ ! -r "$f" ]; then [ -b "$f" ] && parts_udev "${f##*/}"; return 0; fi
    if dump=$(sfdisk -d "$f" 2>/dev/null); then
        ss=$(sed -n 's/^sector-size: *//p' <<<"$dump"); ss=${ss:-512}
        while read -r start size ptype; do
            case "$ptype" in 5|f|85) continue ;; esac     # an extended container, not a filesystem
            part_of "$f" $(( start * ss )) $(( size * ss )); any=1
        done < <(sed -n 's/.*start= *\([0-9]*\), *size= *\([0-9]*\), *type= *\([^, ]*\).*/\1 \2 \3/p' <<<"$dump")
    fi
    if [ "$any" = 0 ]; then         # no partition table: one filesystem on the whole disk, or nothing
        whole=$(part_of "$f" 0)
        [ "${whole%%|*}" != raw ] && echo "$whole"
    fi
    return 0
}

content_fmt() { # stdin: parts_of lines -> "vfat boot 31M · ext4 rootfs 2.1G · ext4 data 12M"
    local t l u used n w out=""
    while IFS='|' read -r t l u used; do
        [ -n "$t" ] || continue
        n="${l:-$u}"; [ ${#n} -gt 12 ] && n="${n:0:8}…"
        w="$t${n:+ $n}"
        [ -n "$used" ] && w="$w $(numfmt --to=iec --round=nearest "$used" 2>/dev/null || echo "$used")"
        out="${out:+$out · }$w"
    done
    echo "${out:-no partition, no filesystem}"
}

shape_fmt() {   # stdin: parts_of lines -> the layout, "vfat:boot ext4:rootfs ext4:data "
    local t l u used
    while IFS='|' read -r t l u used; do [ -n "$t" ] && printf '%s:%s ' "$t" "$l"; done
    return 0
}

IMG_SHAPE=""    # the image's layout, once read; a card of this image STARTS with it (p4 may follow)
content_cell() { # content_cell <parts_of lines> -> the CONTENT cell; exit 1 if not the image's layout
    local cell; cell=$(content_fmt <<<"$1")
    if [ -n "$IMG_SHAPE" ]; then
        case "$(shape_fmt <<<"$1")" in
            "$IMG_SHAPE"*) ;;
            *) echo "${C_WARN}${cell}${C_END}"; return 1 ;;
        esac
    fi
    echo "$cell"
}

layout_note() { # layout_note <cards not of the image's layout> <cards>
    [ "$1" -gt 0 ] || return 0
    warn "$1 of $2 hold another layout than this image (CONTENT in yellow) — make sure it is yours to erase"
}

if [ "$LIST" = 1 ]; then
    printf '%-10s %-24s %-8s %-10s %s\n' DEVICE SERIAL PORT SIZE MODEL
    for d in $(all_disks); do
        if [ "$(size_of "$d")" -gt 0 ]; then sz=$(human "$(bytes_of "$d")"); else sz="empty"; fi
        printf '%-10s %-24s %-8s %-10s %s\n' \
            "/dev/$d" "$(serial_of "$d")" "$(port_of "$d")" "$sz" "$(udev_prop "$d" ID_MODEL)"
    done
    exit 0
fi

# ── the image ────────────────────────────────────────────────────────────────
IMG="${1:-}"; [ -n "$IMG" ] || { usage; exit 2; }; shift
# zsh does not expand ~ after if=/of=, so a path that still carries a literal
# leading tilde here is a file named "~" waiting to happen. Refuse it rather
# than write one.
case "$IMG" in '~'*) err "image path starts with a literal '~' — use \$HOME or an absolute path"; exit 1 ;; esac
[ -f "$IMG" ] || { err "no such image: $IMG"; exit 1; }
IMG=$(readlink -f "$IMG")
IMG_BYTES=$(stat -c %s "$IMG")
[ "$IMG_BYTES" -gt 0 ] || { err "image is empty: $IMG"; exit 1; }
# the disk the image itself lives on is never a target, however removable it is
IMG_SRC=$(df --output=source "$IMG" 2>/dev/null | tail -1)
IMG_SRC=$(lsblk -no PKNAME "$IMG_SRC" 2>/dev/null | head -1)
IMG_PARTS=$(parts_of "$IMG"); IMG_SHAPE=$(shape_fmt <<<"$IMG_PARTS")

if [ "$CONTENT_ONLY" = 1 ]; then
    say "image:  $(content_fmt <<<"$IMG_PARTS")"
    other=0
    for t in "$@"; do
        [ -e "$t" ] || { err "no such disk or image: $t"; exit 1; }
        cell=$(content_cell "$(parts_of "$t")") || other=$(( other + 1 ))
        say "$t:  $cell"
    done
    layout_note "$other" $#
    exit 0
fi

# ── phase 1 — the image, once, before it is cloned N times ───────────────────
# CHECK first, with the read-only tools, and repair only what they found: a
# repair run on a clean filesystem still writes it (`e2fsck -fy` stamps the
# superblock's last-checked time, and the image file's mtime with it), so a
# golden fsck'd that way changed at every burn. Repaired on a finding: the boot
# vfat and the LAST ext4 (RastaOS: p1 boot, p2 rootfs mounted ro on the player,
# p3 /data rw — /data is the one carrying an unreplayed journal). Every other
# ext4 is CHECKED and never written: a golden's rootfs is the thing under test,
# not something to silently repair.

# ext4_unclean <part> — why it needs a repair, on stdout; exit 0 IF IT DOES.
# `e2fsck -fn` alone cannot say: it exits 0 on an unreplayed journal (it skips
# recovery on a read-only check) and on a superblock left "not clean" — the
# exact states phase 1 exists for. So the superblock is read first.
ext4_unclean() {
    local sb feat state
    sb=$(dumpe2fs -h "$1" 2>/dev/null) || { echo "superblock unreadable"; return 0; }
    feat=$(sed -n 's/^Filesystem features: *//p' <<<"$sb")
    state=$(sed -n 's/^Filesystem state: *//p' <<<"$sb")
    case " $feat " in *" needs_recovery "*) echo "unreplayed journal"; return 0 ;; esac
    [ "$state" = clean ] || { echo "superblock state: ${state:-unknown}"; return 0; }
    e2fsck -fn "$1" >/dev/null 2>&1 || { echo "e2fsck -fn reports errors"; return 0; }
    return 1
}

# vfat_unclean <part> — same contract. `fsck.fat -n` exits 1 on the dirty bit
# the rw/ro helper leaves on /boot, and on any other finding.
vfat_unclean() {
    fsck.fat -n "$1" >/dev/null 2>&1 && return 1
    echo "fsck.fat -n reports errors (dirty bit?)"; return 0
}

FSCK_REPAIRED=0; FSCK_WOULD=()
# fsck_image [ro] — ro (the dry run, `-n --fsck-only`): the image goes on a
# READ-ONLY loop, so not one byte of it can be written whatever a tool below
# does; what it would repair is named in FSCK_WOULD and nothing is repaired.
# Before pi-tools#t-070, `-n` was ignored here and a dirty golden was repaired.
fsck_image() {
    local mode=${1:-rw} L rc=0 part fstype p n why act=repair last_ext4="" ext4s=() fix=() lo=(-Pf --show)
    FSCK_REPAIRED=0; FSCK_WOULD=()
    [ "$mode" = ro ] && { lo=(-r -Pf --show); act="would repair"; }
    L=$(losetup "${lo[@]}" "$IMG") || { err "losetup failed on $IMG"; return 1; }
    if [ "$mode" = ro ]; then
        if [ "$(blockdev --getro "$L" 2>/dev/null)" != 1 ]; then
            losetup -d "$L"; err "$L is not read-only — refusing to check $IMG on it"; return 1
        fi
        say "image on $L (read-only)"
    else
        say "image on $L"
    fi
    for p in "$L"p*; do
        [ -b "$p" ] || continue
        [ "$(blkid -o value -s TYPE "$p" 2>/dev/null)" = "ext4" ] && ext4s+=("$p")
    done
    [ ${#ext4s[@]} -gt 0 ] && last_ext4="${ext4s[$(( ${#ext4s[@]} - 1 ))]}"
    for part in "$L"p*; do
        [ -b "$part" ] || continue
        n=${part#"$L"}
        fstype=$(blkid -o value -s TYPE "$part" 2>/dev/null)
        if [ "$fstype" = "vfat" ]; then
            if why=$(vfat_unclean "$part"); then
                say "$n: vfat — $why — $act"; fix+=("$n vfat")
            else
                say "$n: vfat — clean, left as is"
            fi
        elif [ "$fstype" = "ext4" ] && [ "$part" = "$last_ext4" ]; then
            if why=$(ext4_unclean "$part"); then
                say "$n: ext4 (data) — $why — $act"; fix+=("$n ext4")
            else
                say "$n: ext4 (data) — clean, left as is"
            fi
        elif [ "$fstype" = "ext4" ]; then
            if why=$(ext4_unclean "$part"); then
                warn "$n: ext4 — $why (checked, never written)"
            else
                say "$n: ext4 — clean (checked, never written)"
            fi
        else
            say "$n: ${fstype:-unknown} — left alone"
        fi
    done
    if [ "$mode" = ro ]; then              # the dry run stops at the finding
        FSCK_WOULD=("${fix[@]}")
        losetup -d "$L"
        return 0
    fi
    # the repair, only for what the check found — on the SAME loop: detaching
    # and re-attaching (a read-only loop for the check) raced on the desk, the
    # repair then hitting a device still read-only (pi-tools#t-062)
    for p in "${fix[@]}"; do
        FSCK_REPAIRED=1
        read -r n fstype <<<"$p"
        part="$L$n"
        if [ "$fstype" = vfat ]; then
            # exits 1 once it HAS fixed something: the re-check below judges
            fsck.fat -a "$part" >/dev/null 2>&1
            why=$(vfat_unclean "$part") && { err "$n: vfat still unclean after repair — $why"; rc=1; continue; }
        else
            e2fsck -fy "$part" >/dev/null 2>&1
            [ $? -gt 2 ] && { err "$n: e2fsck -fy could not repair it"; rc=1; continue; }   # 1 = fixed, 2 = fixed + reboot advised
            why=$(ext4_unclean "$part") && { err "$n: ext4 still unclean after repair — $why"; rc=1; continue; }
        fi
        say "$n: repaired — clean now"
    done
    losetup -d "$L"
    return $rc
}

if [ "$FSCK_ONLY" = 1 ]; then
    [ "$(id -u)" = 0 ] || { err "--fsck-only needs root for losetup, -n too: pkexec bash $(readlink -f "$0") ${ORIG_ARGS[*]}"; exit 1; }
    if [ "$DRY" = 1 ]; then
        echo "== check the image, read-only (dry run: no repair, no cards)"
        fsck_image ro || { err "image check failed: $IMG"; exit 1; }
        if [ ${#FSCK_WOULD[@]} -gt 0 ]; then
            w=$(printf '%s, ' "${FSCK_WOULD[@]}")
            warn "needs a repair: ${w%, } — run --fsck-only without -n to make it"
        else
            ok "image clean, not written: $IMG"
        fi
        warn "DRY RUN — nothing was written."
        exit 0
    fi
    echo "== clean the image (no cards involved)"
    if fsck_image; then
        if [ "$FSCK_REPAIRED" = 1 ]; then ok "image repaired, clean now: $IMG"; else ok "image clean, not written: $IMG"; fi
        exit 0
    fi
    err "image fsck failed: $IMG"; exit 1
fi

# ── select the targets ───────────────────────────────────────────────────────
refuse_reason() {   # refuse_reason <disk> -> reason on stdout, exit 0 IF REFUSED
    local d="$1" b
    case "$d" in nvme*) echo "nvme — a fixed disk, not a card"; return 0 ;; esac
    [ -n "$IMG_SRC" ] && [ "$d" = "$IMG_SRC" ] && { echo "holds the image we are cloning"; return 0; }
    if [ "$(cat "/sys/block/$d/removable" 2>/dev/null)" != "1" ] && [[ "$d" != mmcblk* ]]; then
        echo "not removable"; return 0
    fi
    b=$(bytes_of "$d")
    [ "$b" -eq 0 ] && { echo "no medium — unseated card? reseat it"; return 0; }
    [ "$b" -lt "$IMG_BYTES" ] && { echo "too small: $(human "$b") < $(human "$IMG_BYTES")"; return 0; }
    return 1
}

TARGETS=()          # "disk|serial|port|bytes", the disk being the plan-time one only
add_target() {      # add_target <disk>
    local d="$1" why s
    if why=$(refuse_reason "$d"); then err "REFUSED /dev/$d — $why"; return 1; fi
    s=$(serial_of "$d")
    if [ -z "$s" ]; then
        err "REFUSED /dev/$d — no reader serial: it could not be re-resolved after a hub reset"
        return 1
    fi
    TARGETS+=("$d|$s|$(port_of "$d")|$(bytes_of "$d")")
}

if [ $# -gt 0 ]; then
    for t in "$@"; do
        case "$t" in
            /dev/*) add_target "$(basename "$t")" || exit 1 ;;
            *)      if ! d=$(dev_for_serial "$t"); then
                        err "no card with serial '$t' is present"; exit 1
                    fi
                    case "$d" in *" "*) err "serial '$t' matches several devices: $d"; exit 1 ;; esac
                    add_target "$d" || exit 1 ;;
        esac
    done
else
    for d in $(disks_with_medium); do
        refuse_reason "$d" >/dev/null && continue      # quietly not a candidate
        add_target "$d" || true
    done
fi
[ ${#TARGETS[@]} -gt 0 ] || { err "no eligible card found (try -l to see the readers)"; exit 1; }

# --flightbox: ask flightbox-p4 about the IMAGE now, read-only. Each card gets
# the image's partition table and root (the cmp proves it), so what it refuses
# here it refuses on every card — said once, before the confirmation, rather
# than once per card after the burn (pi-tools#t-060).
P4_TOOL="$(dirname "$(readlink -f "$0")")/../image/flightbox-p4"
P4_PLAN=""
if [ "$P4" = 1 ] && ! P4_PLAN=$("$P4_TOOL" --check "$IMG" 2>&1); then
    P4_PLAN=${P4_PLAN##*$'\n'}; P4_PLAN=${P4_PLAN%%. Nothing written*}
else
    P4_PLAN=""
fi

echo "burn-batch"
say "image:  $IMG  ($(human "$IMG_BYTES"))"
say "holds:  $(content_fmt <<<"$IMG_PARTS")"
say "cards:  ${#TARGETS[@]}, $JOBS at a time"
say "log:    $LOG"
echo
# CONTENT is read here, in the plan — before the confirmation AND under -y,
# which skips only the confirmation: this table is the last screen before dd.
printf '  %-10s %-24s %-8s %-8s %s\n' DEVICE SERIAL PORT SIZE CONTENT
OTHER=0
for spec in "${TARGETS[@]}"; do
    IFS='|' read -r d s p b <<<"$spec"
    cell=$(content_cell "$(parts_of "/dev/$d")") || OTHER=$(( OTHER + 1 ))
    printf '  %-10s %-24s %-8s %-8s %s\n' "/dev/$d" "$s" "$p" "$(human "$b")" "$cell"
done
echo
layout_note "$OTHER" "${#TARGETS[@]}"
warn "every byte on these ${#TARGETS[@]} cards will be destroyed."
if [ -n "$P4_PLAN" ]; then
    warn "--flightbox: ${P4_PLAN#flightbox-p4: }"
    warn "p4 will be refused on EVERY card: they burn, verify and boot in file mode."
fi

if [ "$DRY" = 1 ]; then
    warn "DRY RUN — nothing was written."
    exit 0
fi

if [ "$(id -u)" != 0 ]; then
    err "the burn needs root. Run the WHOLE thing as one root phase, one prompt:"
    say "pkexec bash $(readlink -f "$0") ${ORIG_ARGS[*]}"
    exit 1
fi

if [ "$YES" != 1 ]; then
    if [ -t 0 ]; then
        read -r -p "  type the number of cards to confirm (${#TARGETS[@]}): " answer
        [ "$answer" = "${#TARGETS[@]}" ] || { err "not confirmed — nothing written"; exit 1; }
    else
        err "not a terminal and no -y — refusing to burn unconfirmed"; exit 1
    fi
fi

if [ "$FSCK" = 1 ]; then
    echo "== phase 1 — clean the image"
    if fsck_image; then
        if [ "$FSCK_REPAIRED" = 1 ]; then ok "image repaired, clean now"; else ok "image clean, not written"; fi
    else
        err "image fsck failed — fix it before cloning it ${#TARGETS[@]} times"; exit 1
    fi
else
    warn "phase 1 skipped (--no-fsck)"
fi

# ── phase 2 — take the cards off the desktop ─────────────────────────────────
echo
echo "== phase 2 — unmount"
for spec in "${TARGETS[@]}"; do
    IFS='|' read -r d s p b <<<"$spec"
    while read -r mp; do
        [ -n "$mp" ] && { umount "$mp" 2>/dev/null && say "/dev/$d: unmounted $mp"; }
    done < <(lsblk -ln -o MOUNTPOINT "/dev/$d" 2>/dev/null)
done
ok "the cards are ours"

RUNDIR=$(mktemp -d /tmp/burn-batch.XXXXXX)
trap 'rm -rf "$RUNDIR"' EXIT

# ── a capped pool ────────────────────────────────────────────────────────────
# The hub is the ceiling, not the reader count: six parallel writes on a
# bus-powered hub raised [Errno 19] on all five hub-side readers at once, while
# the card on a direct port finished alone. -j 3 completed the same batch.
pool() {    # pool <fn> <spec>...
    local fn="$1"; shift
    local running=0 spec
    for spec in "$@"; do
        while [ "$running" -ge "$JOBS" ]; do
            wait -n 2>/dev/null
            running=$(( running - 1 ))
        done
        "$fn" "$spec" &
        running=$(( running + 1 ))
    done
    wait
}

# ── phase 3 — burn ───────────────────────────────────────────────────────────
burn_one() {
    trap - EXIT                 # the RUNDIR cleanup belongs to the parent only
    local spec="$1" d t0 t1 secs rate serial
    IFS='|' read -r _ serial _ _ <<<"$spec"
    if ! d=$(dev_for_serial "$serial"); then
        echo "gone" >"$RUNDIR/$serial.burn"; return
    fi
    case "$d" in *" "*) echo "ambiguous" >"$RUNDIR/$serial.burn"; return ;; esac
    t0=$(date +%s)
    if dd if="$IMG" of="/dev/$d" bs=4M conv=fsync status=none 2>"$RUNDIR/$serial.dd"; then
        t1=$(date +%s); secs=$(( t1 - t0 )); [ "$secs" -lt 1 ] && secs=1
        rate=$(( IMG_BYTES / secs / 1000000 ))
        echo "ok ${secs}s ${rate}MB/s" >"$RUNDIR/$serial.burn"
    else
        echo "failed" >"$RUNDIR/$serial.burn"
    fi
}

echo
echo "== phase 3 — burn ($JOBS at a time)"
pool burn_one "${TARGETS[@]}"
sync
for spec in "${TARGETS[@]}"; do
    IFS='|' read -r d s p b <<<"$spec"
    read -r st rest <<<"$(cat "$RUNDIR/$s.burn" 2>/dev/null)"
    case "$st" in
        ok)        ok "$s: $rest" ;;
        gone)      err "$s: the reader lost the card mid-run" ;;
        ambiguous) err "$s: two devices answer to that serial — nothing written" ;;
        *)         err "$s: dd failed — $(tr '\n' ' ' <"$RUNDIR/$s.dd" 2>/dev/null)" ;;
    esac
done

# ── phase 4 — prove it ───────────────────────────────────────────────────────
# cmp -n stops at the image length, so a card larger than the image is expected
# and is not a mismatch.
#
# --flushbufs FIRST: we have just written these bytes, so a plain read-back can
# be served from the block device's page cache — comparing the image against
# itself and green-lighting the exact silent write failure this pass exists to
# catch. (And cmp against two real files, never `cmp /dev/x <(dd …)`: under
# sudo the process-substitution fd is closed before cmp can read it.)
verify_one() {
    trap - EXIT
    local spec="$1" d serial
    IFS='|' read -r _ serial _ _ <<<"$spec"
    if [ "$(head -c2 "$RUNDIR/$serial.burn" 2>/dev/null)" != "ok" ]; then
        echo "skipped" >"$RUNDIR/$serial.cmp"; return
    fi
    if ! d=$(dev_for_serial "$serial"); then
        echo "gone" >"$RUNDIR/$serial.cmp"; return
    fi
    case "$d" in *" "*) echo "ambiguous" >"$RUNDIR/$serial.cmp"; return ;; esac
    blockdev --flushbufs "/dev/$d" 2>/dev/null
    if cmp -s -n "$IMG_BYTES" "/dev/$d" "$IMG"; then
        echo "identical" >"$RUNDIR/$serial.cmp"
    else
        echo "DIFFERS — $(cmp -n "$IMG_BYTES" "/dev/$d" "$IMG" 2>&1 | head -1)" >"$RUNDIR/$serial.cmp"
    fi
}

echo
echo "== phase 4 — verify, byte for byte ($JOBS at a time)"
pool verify_one "${TARGETS[@]}"

# ── phase 5 — flightbox p4 (--flightbox only) ────────────────────────────────
# Only on a card that verified, one at a time (a 512 MB zero pass each). A card
# p4 cannot fit on stays a good card — flightbox falls back to file mode there —
# so a refusal is reported in the table, never counted as a failed burn.
if [ "$P4" = 1 ]; then
    echo
    echo "== phase 5 — flightbox p4 at each card's tail"
    for spec in "${TARGETS[@]}"; do
        IFS='|' read -r _ s _ _ <<<"$spec"
        [ "$(cat "$RUNDIR/$s.cmp" 2>/dev/null)" = "identical" ] || continue
        if ! d=$(dev_for_serial "$s") || [[ "$d" == *" "* ]]; then
            echo "p4 skipped (card not found)" >"$RUNDIR/$s.p4"; continue
        fi
        if out=$("$P4_TOOL" "/dev/$d" 2>&1); then
            echo "p4 ok" >"$RUNDIR/$s.p4"; say "$s: ${out##*$'\n'}"
        else
            echo "p4 REFUSED" >"$RUNDIR/$s.p4"; warn "$s: ${out##*$'\n'}"
        fi
    done
fi

# ── the table ────────────────────────────────────────────────────────────────
echo
printf '  %-24s %-6s %-16s %s\n' SERIAL PORT BURN VERIFY
FAILED=0
for spec in "${TARGETS[@]}"; do
    IFS='|' read -r d s p b <<<"$spec"
    burn=$(cat "$RUNDIR/$s.burn" 2>/dev/null || echo "?")
    cmpr=$(cat "$RUNDIR/$s.cmp"  2>/dev/null || echo "?")
    p4=$(cat "$RUNDIR/$s.p4" 2>/dev/null || true)
    printf '  %-24s %-6s %-16s %s\n' "$s" "$p" "$burn" "$cmpr${p4:+ · $p4}"
    [ "$cmpr" = "identical" ] || FAILED=$(( FAILED + 1 ))
    echo "$(date -Is),$s,$p,$burn,$cmpr,$(basename "$IMG")" >> "$LOG" 2>/dev/null
done
[ -n "$INVOKER" ] && chown "$INVOKER" "$LOG" 2>/dev/null

echo
printf '\a'
if [ "$FAILED" -eq 0 ]; then
    ok "${#TARGETS[@]}/${#TARGETS[@]} cards identical to the image — safe to remove"
    exit 0
fi
err "$FAILED of ${#TARGETS[@]} cards did NOT verify — those cards are OUT, do not ship them"
say "a card that fails here is usually worn, not unlucky: burn a batch from fresh cards,"
say "and if several failed at once, suspect the hub before the cards (-j 3, powered hub)."
exit 1
