[Unit]
Description=audiohub output forwarder (%i)
After=sound.target

[Service]
ExecStartPre=/sbin/modprobe snd-aloop
ExecStart=/usr/local/bin/audiohub-fwd %i
Restart=always
RestartSec=2
# a wedged alsaloop spins at RT priority and ignores SIGTERM (bench
# 2026-07-21): don't let a stop wait the default 90s before the SIGKILL
TimeoutStopSec=5
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=10

[Install]
WantedBy=multi-user.target
