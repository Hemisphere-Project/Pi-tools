#!/bin/bash
# audiohub forwarder — one per output, run by audiohub@.service
#
#   audiohub-fwd jack|hdmi|usb
#
# Reads the target latency from the audiohub config (/etc/audiohub.conf,
# overridden by /data/audiohub.conf) and execs an alsaloop from the shared
# dsnoop capture (aloopcap) to the sink's egress PCM. The usb variant first
# waits for a USB audio card and picks the STRAIGHT egress matching its
# playback width (usbout2/4/6/8 — never a downmix); on unplug alsaloop exits
# and systemd's Restart=always brings us back to the wait loop — that IS the
# hotplug mechanism.

SINK="$1"

LAT=""
for f in /etc/audiohub.conf /data/audiohub.conf; do
    [ -f "$f" ] || continue
    V=$(sed -n 's/^latency_us=\([0-9]\+\).*/\1/p' "$f" | head -1)
    [ -n "$V" ] && LAT="$V"
done
LAT=${LAT:-30000}
if [ "$LAT" -lt 20000 ]; then
    echo "latency_us=$LAT below the bcm2835 floor, clamping to 20000"
    LAT=20000
fi

cardidx() { sed -n "s/^ *\([0-9]\+\) \[$1 .*/\1/p" /proc/asound/cards | head -1; }

# Never open the capture side while the loopback cable has no writer: an
# aloopcap instance created against a closed cable can come up with degraded
# geometry (2ch) and then poisons every later 8ch open — and the resulting
# 2s crash-loop lockstep keeps the stale shm attached so it never frees
# (bench 2026-07-21, three times: after every mpv restart). Nothing to
# forward while the cable is closed anyway.
wait_cable() {
    while :; do
        LB=$(cardidx Loopback)
        if [ -n "$LB" ]; then
            ST=$(sed -n 1p "/proc/asound/card$LB/pcm0p/sub0/status" 2>/dev/null)
            [ -n "$ST" ] && [ "$ST" != "closed" ] && return
        fi
        sleep 1
    done
}

case "$SINK" in
    jack) DEV="jackout" ;;
    hdmi) DEV="hdmiout" ;;
    usb)
        while true; do
            LINE=$(grep -m1 'USB-Audio' /proc/asound/cards)
            if [ -n "$LINE" ]; then
                IDX=$(echo "$LINE" | awk '{print $1}')
                CARD=$(echo "$LINE" | sed -n 's/^ *[0-9]* *\[\([^ ]*\) *\].*/\1/p')
                [ -n "$CARD" ] && break
            fi
            sleep 2
        done
        CH=$(awk '/^Playback:/{p=1} /^Capture:/{p=0} p && /Channels:/ {if ($2+0>c) c=$2+0} END{print c+0}' \
                 "/proc/asound/card$IDX/stream0" 2>/dev/null)
        CH=${CH:-2}
        if   [ "$CH" -ge 8 ]; then W=8
        elif [ "$CH" -ge 6 ]; then W=6
        elif [ "$CH" -ge 4 ]; then W=4
        else W=2; fi
        if awk '/^Playback:/{p=1} /^Capture:/{p=0} p && /Rates:/' "/proc/asound/card$IDX/stream0" 2>/dev/null | grep -qw 48000; then
            # card speaks the cable rate: straight identity route, no conversion
            DEV="usbout$W:CARD=$CARD"
        else
            # rate-limited card (e.g. ESI GIGAPort HD+: 8ch/44100 only). A
            # rate-converting plug in alsaloop's write path produces measured
            # discontinuities (~160/s, alsa-lib 1.1.8) — the clean path is the
            # raw device with alsaloop's internal libsamplerate bridging the
            # rates (bench-verified: 0 discontinuities). Needs a card width
            # alsaloop can open at 8ch; narrow+rate-limited cards are logged.
            DEV="hw:$CARD"
            [ "$CH" -lt 8 ] && echo "WARNING: card is ${CH}ch and not 48k-capable: direct open may fail"
        fi
        echo "usb card: $CARD (${CH}ch) -> $DEV"
        wait_cable

        # alsaloop does NOT exit when its device vanishes (it error-loops or
        # zombies — bench 2026-07-21, C-Media unplug): supervise the card
        # ourselves and die on unplug so Restart=always re-enters the wait
        # loop above. That IS the hotplug mechanism.
        /usr/bin/alsaloop -C aloopcap -P "$DEV" -r 48000 -f S16_LE -c 8 -t "$LAT" -S auto &
        LOOP=$!
        trap "kill $LOOP 2>/dev/null" TERM INT
        while kill -0 "$LOOP" 2>/dev/null; do
            if ! grep -qE "\[$CARD *\]" /proc/asound/cards; then
                echo "usb card $CARD vanished: recycling forwarder"
                kill "$LOOP" 2>/dev/null
                wait "$LOOP" 2>/dev/null
                exit 1
            fi
            sleep 2
        done
        wait "$LOOP"
        exit $?
        ;;
    *)  echo "usage: audiohub-fwd jack|hdmi|usb"; exit 2 ;;
esac

# jack/hdmi: firmware cards, they never vanish — but their alsaloop can wedge
# silently: sink stuck PREPARED, hw_ptr frozen, alsaloop spinning at RT prio
# with nothing in the journal (bench 2026-07-21, twice, after concurrent unit
# restarts; the RT spin also starves the SD's kworkers). Supervise flow the
# way the usb branch supervises card presence: while the loopback cable has a
# writer, the sink pointer must advance — three misses (~9s) recycles us.
# SIGKILL, not TERM: the spin state ignores SIGTERM (measured).
# STAGGER: closing both firmware PCMs at the same instant can race the VCHI
# service close and oops the kernel (snd_pcm_pre_stop NULL deref in
# vchiq-slot/0, 6.18.38-v7+, bench 2026-07-21 — audio dead until reboot).
# hdmi always waits 2s before killing its alsaloop so the closes serialize;
# stays well under the unit's TimeoutStopSec=5.
# Sink resolution is per-platform: the Pi has one firmware card per output
# (each watched on its pcm0p), x86 HDA has ONE card (PCH) carrying analog as
# device 0 and HDMI as device 3 — so the flow-watch must read the matching
# pcmNp. The STAGGER serialization is vchiq-motivated but kept on x86 too:
# serialized closes cost nothing and keep one behavior on both fleets.
if grep -q '\[PCH ' /proc/asound/cards 2>/dev/null; then
    case "$SINK" in
        jack) SINKCARD="PCH"; SINKPCM="pcm0p"; STAGGER=0 ;;
        hdmi) SINKCARD="PCH"; SINKPCM="pcm3p"; STAGGER=2 ;;
    esac
else
    case "$SINK" in
        jack) SINKCARD="Headphones"; SINKPCM="pcm0p"; STAGGER=0 ;;
        hdmi) SINKCARD="b1"; SINKPCM="pcm0p"; STAGGER=2 ;;
    esac
fi

wait_cable

/usr/bin/alsaloop -C aloopcap -P "$DEV" -r 48000 -f S16_LE -c 8 -t "$LAT" -S auto &
LOOP=$!
trap "sleep $STAGGER; kill -9 $LOOP 2>/dev/null" TERM INT
STALL=0 LASTPTR=-1
while kill -0 "$LOOP" 2>/dev/null; do
    sleep 3
    LB=$(cardidx Loopback); SC=$(cardidx "$SINKCARD")
    CABLE=$(sed -n 1p "/proc/asound/card$LB/pcm0p/sub0/status" 2>/dev/null)
    if [ "$CABLE" != "state: RUNNING" ]; then
        STALL=0; LASTPTR=-1; continue   # no writer on the cable: idle is legit
    fi
    ST=$(sed -n 1p "/proc/asound/card$SC/$SINKPCM/sub0/status" 2>/dev/null)
    PTR=$(grep -h hw_ptr "/proc/asound/card$SC/$SINKPCM/sub0/status" 2>/dev/null | tr -dc 0-9)
    if [ "$ST" = "state: RUNNING" ] && [ -n "$PTR" ] && [ "$PTR" != "$LASTPTR" ]; then
        STALL=0; LASTPTR=$PTR; continue
    fi
    STALL=$((STALL+1)); LASTPTR=${PTR:-$LASTPTR}
    if [ "$STALL" -ge 3 ]; then
        echo "$SINK sink stalled (${ST:-closed}) with a live cable: recycling forwarder"
        sleep "$STAGGER"   # serialize with the sibling's kill (see STAGGER above)
        kill -9 "$LOOP" 2>/dev/null
        wait "$LOOP" 2>/dev/null
        exit 1
    fi
done
wait "$LOOP"
exit $?
