#!/bin/bash
# audiohub — control CLI for the platform audio hub.
#
#   audiohub status              merged config + forwarder health + USB card
#   audiohub status --json       the same, machine-readable (for HPlayer3)
#   audiohub get <key>           print one merged value, no source prefix
#   audiohub set key=value ...   write overrides to /data/audiohub.conf
#   audiohub apply               restart the forwarders (after config edits)
#   audiohub test [jack|hdmi|usb]
#                                play the test sound through the whole hub
#                                (no arg), or through ONE physical output
#                                (its forwarder is paused around the test)
#   audiohub mute|unmute [hdmi]  softvol-mute the HDMI output, instantly and
#                                persistently (mute=hdmi in /data/audiohub.conf,
#                                restored by the forwarder at unit start).
#                                hdmi only: the other outputs have no softvol.
#
# This is the third-party control surface: applications (HPlayer2, HPlayer3,
# anything) either shell out to `audiohub set ... && audiohub apply` or write
# /data/audiohub.conf themselves and restart the audiohub@* units.

DIR="$(dirname "$(readlink -f "$0")")"
UNITS="audiohub@jack audiohub@hdmi audiohub@usb"

merged() {
    for f in /etc/audiohub.conf /data/audiohub.conf; do
        [ -f "$f" ] && sed -n 's/^\([a-z_]\+=.*\)/\1/p' "$f" | sed "s|^|$f: |"
    done
}

# Final effective key=value (later file wins), machine-readable, no source prefix.
finalcfg() {
    for f in /etc/audiohub.conf /data/audiohub.conf; do
        [ -f "$f" ] && sed -n 's/^\([a-z_]\+\)=\(.*\)/\1 \2/p' "$f"
    done | awk '{v[$1]=$2} END{for (k in v) print k"="v[k]}' | sort
}

case "${1:-status}" in

status)
    if [ "${2:-}" = "--json" ]; then
        cfg=$(finalcfg | awk -F= '{printf "%s\"%s\":\"%s\"", (NR>1?",":""), $1, $2}')
        fwd=""
        for u in $UNITS; do
            fwd="$fwd${fwd:+,}\"${u#audiohub@}\":\"$(systemctl is-active "$u" 2>/dev/null)\""
        done
        usb=$(grep -m1 'USB-Audio' /proc/asound/cards | sed -n 's/^ *[0-9]* *\[\([^ ]*\) *\].*/\1/p')
        printf '{"config":{%s},"forwarders":{%s},"usb_card":"%s","mute":"%s"}\n' \
               "$cfg" "$fwd" "$usb" "$(finalcfg | sed -n 's/^mute=//p')"
        exit 0
    fi
    echo "== config (later wins):"
    merged
    echo "== forwarders:"
    for u in $UNITS; do
        printf "  %-16s %s\n" "$u" "$(systemctl is-active $u 2>/dev/null)"
    done
    echo "== usb card:"
    grep 'USB-Audio' /proc/asound/cards || echo "  (none)"
    echo "== hdmi mute:"
    if finalcfg | grep -q '^mute=.*hdmi'; then echo "  MUTED (mute=hdmi)"
    else echo "  unmuted"; fi
    ;;

set)
    shift
    [ $# -ge 1 ] || { echo "usage: audiohub set key=value [...]"; exit 2; }
    [ -d /data ] || { echo "/data not available: edit /etc/audiohub.conf instead"; exit 1; }
    touch /data/audiohub.conf
    for kv in "$@"; do
        K="${kv%%=*}"
        echo "$kv" | grep -q '=' || { echo "skipping '$kv' (want key=value)"; continue; }
        if grep -q "^$K=" /data/audiohub.conf; then
            sed -i "s|^$K=.*|$kv|" /data/audiohub.conf
        else
            echo "$kv" >> /data/audiohub.conf
        fi
        echo "set $kv"
    done
    echo "run 'audiohub apply' to take effect"
    ;;

apply)
    # one at a time: restarting all three at once can leave a sink wedged
    # PREPARED with alsaloop spinning (bench 2026-07-21, twice); sequential
    # starts never did
    for u in $UNITS; do
        systemctl restart "$u"
        sleep 1
    done
    echo "forwarders restarted"
    ;;

test)
    SINK="${2:-}"
    if [ -z "$SINK" ]; then
        # the hub PCM is held by the running player, so no-arg walks the
        # physical outputs one by one instead (usb only when a card is there)
        "$0" test jack
        "$0" test hdmi
        grep -q 'USB-Audio' /proc/asound/cards && "$0" test usb
    else
        case "$SINK" in
            jack) DEV=jackout ;;
            hdmi) DEV=hdmiout ;;
            usb)
                LINE=$(grep -m1 'USB-Audio' /proc/asound/cards) || { echo "no USB card"; exit 1; }
                CARD=$(echo "$LINE" | sed -n 's/^ *[0-9]* *\[\([^ ]*\) *\].*/\1/p')
                DEV="usbout2:CARD=$CARD" ;;
            *) echo "usage: audiohub test [jack|hdmi|usb]"; exit 2 ;;
        esac
        echo "pausing audiohub@$SINK, playing test sound on $DEV..."
        systemctl stop "audiohub@$SINK"
        aplay -q -D "$DEV" "$DIR/marimba.wav"
        systemctl start "audiohub@$SINK"
    fi
    ;;

get)
    K="${2:-}"
    [ -n "$K" ] || { echo "usage: audiohub get <key>"; exit 2; }
    v=$(finalcfg | sed -n "s/^$K=//p")
    [ -n "$v" ] && { printf '%s\n' "$v"; exit 0; }
    exit 1
    ;;

mute|unmute)
    SINK="${2:-hdmi}"
    [ "$SINK" = "hdmi" ] || { echo "no softvol stage on '$SINK' (hdmi only)"; exit 2; }
    # live toggle: instant, no unit restart, no PCM close (the control lives
    # on the Loopback card and exists once the forwarder has opened hdmiout)
    # resolution 2 makes the control a SWITCH (pswitch): drive it with
    # off/on — percentage values address volumes and no-op on a switch
    if [ "$1" = "mute" ]; then V="off"; else V="on"; fi
    amixer -q -c Loopback sset 'Audiohub HDMI' "$V" 2>/dev/null \
        || echo "softvol control not up yet (old graph, or forwarder not started):" \
                "persisted anyway, the forwarder applies it at unit start"
    # persistence: /data/audiohub.conf is the source of truth the forwarder
    # restores at every unit start (survives reboot on a read-only rootfs)
    if [ -d /data ]; then
        touch /data/audiohub.conf
        sed -i '/^mute=/d' /data/audiohub.conf
        [ "$1" = "mute" ] && echo 'mute=hdmi' >> /data/audiohub.conf
    else
        echo "/data not available: this won't survive a reboot"
    fi
    echo "hdmi ${1}d"
    ;;

*)
    sed -n '2,21p' "$0" | sed 's/^# \?//'
    ;;
esac
