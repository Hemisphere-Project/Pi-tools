#!/bin/bash
TAG="hostrename"
log() { echo "[$TAG] $1"; logger -t "$TAG" "$1"; }

# Source with_rw if available
[ -f /usr/local/lib/pitools/with_rw.sh ] && source /usr/local/lib/pitools/with_rw.sh

# Boot (FAT) partition: /boot/firmware on modern Pi OS (Bookworm), /boot otherwise
BOOTDIR=$([ -d /boot/firmware ] && echo /boot/firmware || echo /boot)

if [ "$#" -eq  "0" ]; then
 	name=rastapi-unknown
else
 	name=$1
fi

# Validate hostname: RFC 1123 (alphanumeric + hyphens, max 63 chars)
if ! echo "$name" | grep -qE '^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$'; then
	log "ERROR: invalid hostname '$name' (must be alphanumeric/hyphens, 1-63 chars)"
	exit 1
fi

log "Setting name: $name"

current=$(cat /etc/hostname)
if [[ $current == $name ]]; then
	log "hostname already set as $name"
	exit 0
fi

with_rw "
systemctl restart systemd-hostnamed
sed -i -E 's/^127.0.1.1.*/127.0.1.1\t$name/' /etc/hosts
for file in $BOOTDIR/wifi/*-hotspot.nmconnection $BOOTDIR/wifi/_disabled/*-hotspot.nmconnection; do
	if [ -f \"\$file\" ]; then
		sed -i -E 's/^ssid=.*/ssid=$name/' \"\$file\"
		echo \"updated \$(basename \"\$file\") name\"
	fi
done
hostnamectl set-hostname '$name'
sync
"

current=$(cat /etc/hostname)
if [[ $current != $name ]]; then
	log "hostnamectl failed, trying manual edit"
	with_rw "echo '$name' > /etc/hostname && sync"
fi

systemctl restart avahi-daemon
setnet

current=$(cat /etc/hostname)
if [[ $current != $name ]]; then
	log "hostname change failed, current: $current, expected: $name"
	exit 1
fi

log "hostname changed to $name"
exit 0